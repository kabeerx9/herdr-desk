{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "desk-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true,
          "hidden": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "center",
              "type": "stack",
              "active": "chat",
              "children": [
                {
                  "id": "chat",
                  "type": "block",
                  "content": {
                    "mod": "desk",
                    "props": {
                      "main": true
                    }
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 10
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "desk-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ],
              "floating": [
                {
                  "id": "desk-card",
                  "content": {
                    "mod": "desk",
                    "props": {
                      "card": true
                    }
                  },
                  "edge": "right",
                  "align": "start"
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "desk",
      "type": "block",
      "content": {
        "mod": "desk",
        "props": {
          "projects": [
            {
              "name": "sfs-native",
              "folder": "~/Desktop/work/shotgun/frontend/sfs-native",
              "repo": "Shotgun-Fantasy-Sports-Dev/sfs-native",
              "reviews": true
            },
            {
              "name": "go-draft-room",
              "folder": "~/Desktop/work/shotgun/backend/go-draft-room",
              "repo": "deepusfs/go-draft-room",
              "reviews": true
            },
            {
              "name": "tattvix",
              "folder": "~/Desktop/projects/tattvix",
              "repo": "kabeerx9/Tattvix"
            },
            {
              "name": "bumpatlas",
              "folder": "~/Desktop/projects/bumpatlas",
              "repo": "kabeerx9/bumpatlas"
            },
            {
              "name": "Hints-City",
              "folder": "~/Desktop/projects/Hints-City",
              "repo": "kabeerx9/Hints-City"
            },
            {
              "name": "goreeva",
              "folder": "~/Desktop/work/goreeva/frontend/new-dashboard",
              "repo": "kabeerx9/Goreeva-frontend"
            }
          ]
        }
      },
      "size": {
        "px": 340
      },
      "min": 260,
      "max": 560,
      "background": "chrome"
    },
    {
      "id": "desk-rail",
      "type": "block",
      "size": {
        "px": 48
      },
      "background": "chrome",
      "content": {
        "mod": "desk",
        "props": {
          "rail": true
        }
      }
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "desk-light",
    "dark": "graphite"
  },
  "colors": {
    "selection": "#2563eb33"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
