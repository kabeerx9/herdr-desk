#!/usr/bin/env python3
"""team: start and report for the Desk's role agents (see mods/desk/roles.json).

  team start <role> [--repo DIR] [--brief FILE] [--task TEXT] [--slug SLUG]
                    [--parent T | --no-parent] [--space ID] [--requested] [--share] [--by WHO]
  team report <done|blocked|update> "<summary>"
  team say "<message>"                      post to your desk's chat (Markdown renders)
  team ask <role> "<question>"              ask someone in your desk; their reply comes back to you
  team route <role> "<Kabeer's question>"   (CTO) pass a question on; their reply goes to the chat
  team answer <id> "<answer>"               answer an ask by hand (replies are posted automatically)
  team inbox [--all]                        what's new in your desk's chat since you last looked
  team post --task SLUG --to ADDR:ROLE... "<message>"   (the Desk) Kabeer's chat message
  team finish [--address T] [--keep-worktree]  wrap up: flag leftovers, or remove the team worktree and close
  team hook claude|codex                    (the CLIs' end-of-turn hook) posts a reply the chat is waiting for
  team hook claude-permission               (Claude's PermissionRequest hook) asks in the desk chat, waits for Allow/Deny
  team permit --task SLUG <id> allow|always|deny [--message TEXT]   (the Desk's buttons) answer a pending permission request
  team new-desk [--name NAME] [--repo DIR]  a desk: an independent team with its own thread; prints its slug
  team compact --address T                  a long context: Claude's /compact (same session, history summarized)
  team fresh --address T [--force]          or a new session: it writes a handoff, then a new one of it takes over
  team roles

One launcher for everyone (the CTO, the Desk's buttons, you): it reads roles.json,
gives every editing role its own git worktree, and starts the role with hc in its own Herdr tab, labeled role=<id> task=<slug>.
Children always outlive their parent, so closing the CTO doesn't end its workers.
"""
import json, os, re, secrets, shutil, subprocess, sys, time

APP = os.environ.get("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app")
DESK = os.path.join(APP, "mods", "desk")
WORKTREES = os.path.expanduser("~/.herdr/worktrees")
ME = os.environ.get("HC_TERMINAL_ID")
SELF = os.path.join(APP, "bin", "team")


def die(msg, code=1):
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


def sh(args, cwd=None, check=False):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"{' '.join(args[:3])}… failed: {(r.stderr or r.stdout).strip()}")
    return r


def hc_json(*args):
    r = sh(["hc", *args, "--json"])
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


FRESH_AT = 250_000  # roles.json "fresh_at" (or a role's own) overrides it


def roles_file():
    with open(os.path.join(DESK, "roles.json")) as f:
        return json.load(f)


def fresh_at(role_id):
    try:
        data = roles_file()
    except (OSError, ValueError):
        return FRESH_AT
    role = next((r for r in data.get("roles", []) if r.get("id") == role_id), {})
    return int(role.get("fresh_at") or data.get("fresh_at") or FRESH_AT)


def load_roles():
    roles = roles_file()["roles"]
    try:
        with open(os.path.join(DESK, "roles", "protocol.md")) as f:
            protocol = f.read().strip()
    except OSError:
        protocol = ""
    for r in roles:
        r.setdefault("id", r["name"].lower())
        text = ""
        if r.get("prompt"):
            with open(os.path.join(DESK, r["prompt"])) as f:
                text = f.read().strip()
        r["promptText"] = "\n\n".join(p for p in (text, protocol) if p)
    return roles


def argv_for(role, task):
    if isinstance(role.get("argv"), list):
        return role["argv"] + ([task] if task else [])
    prompt, extra, effort = role["promptText"], role.get("args", []), role.get("effort")
    if role.get("cli") == "codex":
        # --no-daemon: otherwise Codex runs its commands outside hc. -c parses TOML;
        # a JSON string is a valid TOML basic string, and a JSON list a TOML array.
        base = ["codex", "--no-daemon"] + (["-m", role["model"]] if role.get("model") else [])
        base += ["-c", f'model_reasoning_effort="{effort}"'] if effort else []
        base += ["-c", "notify=" + json.dumps([SELF, "hook", "codex"])]
        base += ["-c", "developer_instructions=" + json.dumps(prompt)] if prompt else []
    else:
        # --tools first: it takes several values, so a value-less flag must follow it, never the task.
        # Fewer tools and no MCP servers keep every call's prompt small (measured 41k -> 17k tokens).
        base = ["claude"] + (["--tools", ",".join(role["tools"])] if role.get("tools") else [])
        base += [] if role.get("mcp") else ["--strict-mcp-config"]
        base += ["--model", role["model"]] if role.get("model") else []
        base += ["--effort", effort] if effort else []
        base += ["--permission-mode", role["permission_mode"]] if role.get("permission_mode") else []
        # Stop: post replies, measure context. SessionStart after a compaction (asked for or Claude's own): its new size.
        # PermissionRequest: what it would ask in its terminal, asked in the desk chat (team permit answers).
        base += ["--settings", json.dumps({"hooks": {
            "Stop": [{"hooks": [{"type": "command", "command": f"{SELF} hook claude", "timeout": 20}]}],
            "SessionStart": [{"matcher": "compact", "hooks": [{"type": "command", "command": f"{SELF} hook claude-compact", "timeout": 20}]}],
            "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "command", "command": f"{SELF} hook claude-permission", "timeout": PERMIT_TIMEOUT}]}]}})]
        base += ["--append-system-prompt", prompt] if prompt else []
    return base + extra + ([task] if task else [])


def repo_of(folder):
    top = sh(["git", "rev-parse", "--show-toplevel"], cwd=folder)
    common = sh(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=folder)
    if top.returncode or common.returncode:
        return None
    common = common.stdout.strip()
    main = common[:-5] if common.endswith("/.git") else common
    return {"top": top.stdout.strip(), "main": main, "common": common, "name": os.path.basename(main)}


def inside(path, d):
    return bool(path) and (path == d or path.startswith(d.rstrip("/") + "/"))


CHAT = os.path.expanduser("~/.herdr/team")
# Pending permission requests: the Desk's buttons (team permit) drop the answer here as <id>.json.
PERMITS = os.path.join(CHAT, ".permits")
PERMIT_TIMEOUT = 600  # the hook's timeout in Claude's settings, seconds
PERMIT_WAIT = float(os.environ.get("TEAM_PERMIT_WAIT", PERMIT_TIMEOUT - 60))  # give up well before Claude kills it


def chat_file(slug):
    slug = re.sub(r"[^a-z0-9_-]+", "-", (slug or "untracked").lower()).strip("-") or "untracked"
    return os.path.join(CHAT, f"{slug}.jsonl")


def chat_append(slug, rec):
    """One thread per desk, outside any repo, since a desk can span several."""
    os.makedirs(CHAT, exist_ok=True)
    rec = {"at": int(time.time() * 1000), **rec}
    with open(chat_file(slug), "a") as f:
        f.write(json.dumps(rec) + "\n")
    return rec


def chat_read(slug):
    try:
        with open(chat_file(slug)) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def chat_line(r, width=800):
    who = "Kabeer" if r.get("from") == "kabeer" else r.get("from", "?")
    to = f" → {', '.join(r['to'])}" if r.get("to") else ""
    kind = "" if r.get("kind") == "say" else f" ({r.get('kind')})"
    text = (r.get("text") or "").strip()
    if len(text) > width:
        text = text[:width] + "… [cut; `team thread` has it all]"
    return f"[{time.strftime('%H:%M', time.localtime(r.get('at', 0) / 1000))}] {who}{to}{kind}: {text}"


def cursors_file(slug):
    return chat_file(slug)[:-len(".jsonl")] + ".cursors.json"


def unread(slug, address, advance=True):
    """Chat records `address` hasn't seen: after its cursor, not its own, not ones sent to it.
    One file per desk keeps each agent's cursor, so nothing repeats and nothing is skipped."""
    recs = chat_read(slug)
    try:
        with open(cursors_file(slug)) as f:
            cur = json.load(f)
    except (OSError, ValueError):
        cur = {}
    new = [r for r in recs[cur.get(address, 0):] if r.get("kind") != "desk" and r.get("address") != address
           and address not in (r.get("delivered_to") or [])]
    if advance:
        cur[address] = len(recs)
        tmp = cursors_file(slug) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cur, f)
        os.replace(tmp, cursors_file(slug))
    return new


def digest_for(slug, address, limit=20):
    new = unread(slug, address)
    if not new:
        return ""
    lines = [chat_line(r, 500) for r in new[-limit:]]
    more = f" ({len(new) - limit} earlier not shown; `{SELF} inbox --all` has everything)" if len(new) > limit else ""
    return "\n\nAlso new in the chat" + more + ":\n" + "\n".join(lines)


def desk_members(slug):
    """The desk's live agents, with their labels (hc ls filters by label but doesn't print them)."""
    d = hc_json("ls", "--label", f"task={slug}") or {}
    items = d.get("terminals", []) if isinstance(d, dict) else d
    out = []
    for t in items:
        if isinstance(t, dict) and t.get("state") == "live":
            info = terminal(t["address"])
            if (info.get("labels") or {}).get("role"):
                out.append({**t, "labels": info["labels"]})
    return out


def expect_reply(addr, what):
    """Marks a terminal as owing a reply; its end-of-turn hook posts that reply (team hook)."""
    sh(["hc", "label", addr, f"awaiting={what}:{int(time.time() * 1000)}"])


def send_text(addr, text):
    r = sh(["hc", "send", addr, text])
    if r.returncode == 0:
        return None
    why = (r.stderr or r.stdout).strip()
    try:
        why = json.loads(why)["error"]["message"]
    except (ValueError, KeyError, TypeError):
        pass
    return why[:160]


def live_terminals():
    d = hc_json("ls") or {}
    items = d.get("terminals", []) if isinstance(d, dict) else d
    return [t for t in items if isinstance(t, dict) and t.get("state") == "live"]


def terminal(t):
    return hc_json("get", t) or {}


def accept_trust(name, cli):
    """Answers the CLI's folder-trust prompt, for a worktree this script just made from a repo
    already in use. Claude's prompt defaults to "No, exit", so it needs down then enter."""
    for _ in range(40):
        # Once the agent reports a status it's past any trust prompt.
        st = terminal(name).get("status")
        if isinstance(st, dict) and st.get("state"):
            return False
        screen = sh(["hc", "read", "--lines", "0", name]).stdout
        if cli == "codex" and "Trust this folder?" in screen:
            sh(["hc", "keys", name, "enter"])
            return True
        if cli != "codex" and "Yes, I trust this folder" in screen:
            sh(["hc", "keys", name, "down", "enter"])
            return True
        time.sleep(0.5)
    return False


def add_worktree(repo, role):
    stamp = time.strftime("%m%d-%H%M%S")
    branch = f"team/{role['id']}-{stamp}"
    path = os.path.join(WORKTREES, repo["name"], re.sub(r"[^A-Za-z0-9._-]+", "-", branch))
    sh(["git", "worktree", "add", "-b", branch, path, "HEAD"], cwd=repo["top"], check=True)
    return path, branch


def unique_name(base):
    base = re.sub(r"[^a-z0-9_-]+", "-", base.lower()).strip("-")[:28] or "role"
    taken = {t.get("name") for t in live_terminals()}
    name, n = base, 2
    while name in taken:
        name, n = f"{base[:26]}-{n}", n + 1
    return name


def file_brief(path, role_id):
    """Moves a queued brief to team/sent/ so it's handed off once; returns where it went."""
    d = os.path.dirname(path)
    # team/briefs/<desk>/<role>.md, or the older team/briefs/<role>.md
    if os.path.basename(os.path.dirname(d)) == "briefs":
        d = os.path.dirname(d)
    elif os.path.basename(d) != "briefs":
        return path
    sent = os.path.join(os.path.dirname(d), "sent")
    os.makedirs(sent, exist_ok=True)
    dest = os.path.join(sent, f"{role_id}-{int(time.time() * 1000)}.md")
    shutil.move(path, dest)
    return dest


def rename_tab(tab, name):
    # The app sees a new labeled terminal within a moment; retry until its tab exists.
    for _ in range(12):
        r = sh(["herdr-app", "do", "tab.rename", json.dumps({"id": tab, "name": name})])
        try:
            if r.returncode == 0 and json.loads(r.stdout).get("ok"):
                return True
        except ValueError:
            pass
        time.sleep(0.25)
    return False


def start(args):
    roles = load_roles()
    role = next((r for r in roles if r["id"] == args.role or r["name"].lower() == args.role.lower()), None)
    if not role:
        die(f"no role {args.role!r}; known: {', '.join(r['id'] for r in roles)}")
    if role.get("on_request") and not args.requested:
        die(f"{role['name']} starts only when Kabeer asks for it. If Kabeer did, pass --requested.", 2)

    folder = os.path.abspath(os.path.expanduser(args.repo or os.getcwd()))
    need_core()
    me = terminal(ME) if ME else {}
    caller_labels = me.get("labels", {})
    # A brief in team/briefs/<desk>/ belongs to that desk.
    brief_desk = None
    if args.brief:
        bd = os.path.dirname(os.path.abspath(os.path.expanduser(args.brief)))
        if os.path.basename(os.path.dirname(bd)) == "briefs":
            brief_desk = os.path.basename(bd)
    slug = args.slug or caller_labels.get("task") or brief_desk or f"{role['id']}-{time.strftime('%m%d-%H%M')}"
    slug = re.sub(r"[^a-z0-9_-]+", "-", slug.lower()).strip("-")[:40]

    note, branch = None, None
    repo = repo_of(folder)
    # Editing roles always get their own worktree, so none starts in Kabeer's checkout or on main,
    # and two desks in one repo never share files.
    if role.get("worktree") and repo and not args.share:
        folder, branch = add_worktree(repo, role)
        note = f"own worktree on {branch} (from HEAD; uncommitted changes in {repo['name']} aren't in it)"

    task = args.task or ""
    if args.brief:
        brief = file_brief(os.path.abspath(os.path.expanduser(args.brief)), role["id"])
        task = (f"Your brief is in {brief}. Read it, then carry it out within the files and contract it gives you. "
                + task).strip()
    if task:
        task += f"\n\n(Team task: {slug}. Report with `{SELF} report done|blocked \"<summary>\"` when done or stuck.)"

    space = args.space or caller_labels.get("herdr.space") or "spteam" + secrets.token_hex(8)
    tab = args.tab or "tb" + secrets.token_hex(16)
    name = unique_name(f"{role['id']}-{slug}")
    cmd = ["hc", "run", "--bg", "--outlive-parent", "--name", name, "--cwd", folder,
           "--label", f"role={role['id']}", "--label", f"task={slug}", "--label", f"by={args.by or ME or 'shell'}",
           "--label", f"herdr.space={space}", "--label", f"herdr.tab={tab}"]
    cmd += ["--no-parent"] if args.no_parent else (["--parent", args.parent] if args.parent else [])
    # Through the user's own login + interactive shell: hc's environment lacks what ~/.zshrc sets
    # up (nvm's node and npm, Android tools). exec swaps the shell for the agent itself.
    shell = os.environ.get("SHELL") or "/bin/zsh"
    desk_note = f"\n\nYour desk is `{slug}`: your team chat and, for briefs, `team/briefs/{slug}/`."
    if repo:
        decisions = os.path.join(repo["common"], "team", "desks", slug, "decisions.md")
        desk_note += (f" The desk's decisions file is `{decisions}` (contracts, data model, what's done and left): "
                      + ("keep it current, rewritten not appended, under 100 lines." if role["id"] == "cto"
                         else "read it before you start, if it exists."))
    role = {**role, "promptText": role["promptText"] + desk_note}
    cmd += ["--", shell, "-lic", 'exec "$@"', "team-role"] + argv_for(role, task)
    r = sh(cmd)
    if r.returncode != 0:
        die(f"hc run failed: {(r.stderr or r.stdout).strip()}")
    try:
        launched = json.loads(r.stdout)
    except ValueError:
        launched = {"raw": r.stdout.strip()}

    # The CTO that fans a task out is part of it too, so the Desk groups them.
    if ME and caller_labels.get("role") == "cto" and caller_labels.get("task") != slug:
        sh(["hc", "label", ME, f"task={slug}"])
    starter = caller_labels.get("role") or ("kabeer" if args.by == "desk" else (ME or "shell"))
    if args.fresh_of:
        chat_append(slug, {"from": role["id"], "kind": "fresh", "role": role["id"], "address": launched.get("address"),
                           "replaces": args.fresh_of, "text": args.note or f"{role['name']} started fresh"})
    else:
        chat_append(slug, {"from": starter, "kind": "start", "role": role["id"], "address": launched.get("address"),
                           "text": f"Started {role['name']} in {os.path.basename(folder)}" + (f" on {branch}" if branch else "")})
    renamed = rename_tab(tab, role["name"])
    trusted = accept_trust(name, role.get("cli")) if branch else None
    print(json.dumps({"address": launched.get("address"), "name": name, "role": role["id"], "task": slug,
                      "cwd": folder, "branch": branch, "note": note, "tab": tab, "tab_named": renamed, "trust_accepted": trusted,
                      "hint": "A trust prompt in a new folder shows as 'Needs you'; its task runs once accepted."}))


SANDBOX_HINT = ("hc can't reach herdr-core from here. If you're in a sandbox (Codex's blocks hc's socket), "
                "rerun this exact command with escalated permissions / outside the sandbox.")


def need_core():
    r = sh(["hc", "get", ME or "self", "--json"]) if ME else sh(["hc", "server", "status"])
    if r.returncode != 0:
        die(f"{SANDBOX_HINT} ({(r.stderr or r.stdout).strip()[:160]})", 3)


def report(args):
    if not ME:
        die("team report runs inside an hc terminal ($HC_TERMINAL_ID is unset)")
    need_core()
    me = terminal(ME)
    labels = me.get("labels", {})
    text = " ".join(args.text).strip()
    if not text:
        die("say what happened: team report done \"<what changed, what you verified>\"")
    lr = sh(["hc", "label", ME, f"phase={args.kind}", f"note={text[:240]}"])
    if lr.returncode != 0:
        die(f"couldn't record the report: {(lr.stderr or lr.stdout).strip()[:200]}", 3)
    who = labels.get("role") or me.get("name") or ME
    sent = False
    parent = me.get("parent")
    if not (parent and terminal(parent).get("state") == "live") and labels.get("task") and labels.get("role") != "cto":
        cto = next((t for t in desk_members(labels["task"]) if t["labels"]["role"] == "cto" and t["address"] != ME), None)
        parent = cto["address"] if cto else None
    if parent:
        r = sh(["hc", "send", parent, f"[{who} {args.kind}] {text}"])
        sent = r.returncode == 0
        if not sent:
            print(json.dumps({"warning": f"recorded, but not delivered to {parent}: {(r.stderr or r.stdout).strip()[:200]}"}), file=sys.stderr)
    chat_append(labels.get("task"), {"from": who, "address": ME, "kind": args.kind, "text": text,
                                     **({"delivered_to": [parent]} if sent else {})})
    print(json.dumps({"ok": True, "phase": args.kind, "sent_to_parent": parent if sent else None}))


def me_in_desk():
    if not ME:
        die("this runs inside an hc terminal ($HC_TERMINAL_ID is unset)")
    need_core()
    me = terminal(ME)
    labels = me.get("labels", {})
    return labels.get("task"), labels.get("role") or me.get("name") or ME


def say(args):
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    if not text:
        die("nothing to say")
    chat_append(slug, {"from": who, "address": ME, "kind": "say", "text": text})
    print(json.dumps({"ok": True, "task": slug}))


def ask(args):
    """A question to someone in the desk: one way, answered once with `team answer`,
    so agents never end up talking back and forth on their own."""
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    if not slug or not text:
        die("ask needs a desk (a task label) and a question")
    members = [t for t in desk_members(slug) if t.get("address") != ME]
    targets = [t for t in members if args.role in (t["labels"]["role"], t.get("address"))]
    if not targets:
        here = ", ".join(sorted({t["labels"]["role"] for t in members})) or "nobody else"
        die(f"no {args.role} in this desk (here: {here})")
    qid = "q" + secrets.token_hex(3)
    delivered, failed = [], []
    for t in targets:
        why = send_text(t["address"], f"[desk chat] {who} asks you ({qid}): {text}")
        if not why:
            expect_reply(t["address"], f"ask-{qid}")
        (failed.append({"role": t["labels"]["role"], "why": why}) if why else delivered.append(t["address"]))
    rec = chat_append(slug, {"from": who, "address": ME, "kind": "ask", "id": qid, "to": [targets[0]["labels"]["role"]],
                             "text": text, "delivered_to": delivered, "failed": failed})
    print(json.dumps({"id": qid, "delivered_to": delivered, "failed": failed, "at": rec["at"]}))


def answer(args):
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    q = next((r for r in reversed(chat_read(slug)) if r.get("kind") == "ask" and r.get("id") == args.id), None)
    if not q:
        die(f"no question {args.id} in this desk's chat")
    note = f"[desk chat] {who} answers {args.id}: {text}"
    asker = q.get("address")
    if (terminal(asker).get("labels") or {}).get("role") == "cto":
        note += digest_for(slug, asker)
    why = send_text(asker, note) if terminal(asker).get("state") == "live" else "the asker isn't running"
    chat_append(slug, {"from": who, "address": ME, "kind": "answer", "re": args.id, "to": [q.get("from")], "text": text,
                       **({"failed": [{"role": q.get("from"), "why": why}]} if why else {"delivered_to": [asker]})})
    print(json.dumps({"ok": not why, **({"warning": f"logged, not delivered: {why}"} if why else {})}))


def route(args):
    """The CTO passes Kabeer's question to whoever knows; their reply goes to the chat
    for Kabeer directly, so the CTO never rewrites it."""
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    members = [t for t in desk_members(slug) if t.get("address") != ME] if slug else []
    targets = [t for t in members if args.role in (t["labels"]["role"], t.get("address"))]
    if not targets:
        here = ", ".join(sorted({t["labels"]["role"] for t in members})) or "nobody else"
        die(f"no {args.role} in this desk (here: {here})")
    t = targets[0]
    why = send_text(t["address"], f"[desk chat] Kabeer (via {who}): {text}")
    if not why:
        expect_reply(t["address"], "chat")
    chat_append(slug, {"from": who, "address": ME, "kind": "route", "to": [t["labels"]["role"]], "text": text,
                       **({"failed": [{"role": t["labels"]["role"], "why": why}]} if why else {"delivered_to": [t["address"]]})})
    print("passed on; the reply goes to the chat" if not why else f"not delivered: {why}")


def hook(args):
    """End of an agent's turn (Claude's Stop hook, Codex's notify). For Claude, records how big
    its context is now (the ctx label). When the turn answered a desk message, its final message is posted
    for it: the agent replies once, in its own words, and never types it again into `team say`.
    When the turn wrote a handoff (team fresh), a new session takes over. After a compaction
    (claude-compact, Claude's SessionStart hook), its new size. Quick; never blocks."""
    msg = ""
    if args.cli == "claude-compact":
        return compacted()
    if args.cli == "claude-permission":
        return permission_request()
    try:
        if args.cli == "codex":
            payload = json.loads(args.payload[-1]) if args.payload else {}
            chain_codex_notify(args.payload)
            if payload.get("type") != "agent-turn-complete":
                return
            msg = payload.get("last-assistant-message") or ""
        else:
            payload = json.load(sys.stdin)
            msg = payload.get("last_assistant_message") or last_text(payload.get("transcript_path"))
            # Claude writes the turn's usage just after this hook, so it's measured a moment later, apart.
            if ME and payload.get("transcript_path"):
                env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
                subprocess.Popen([SELF, "measure", "--address", ME, "--transcript", payload["transcript_path"]], env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except (ValueError, OSError):
        return
    if not ME:
        return
    labels = terminal(ME).get("labels", {})
    awaiting, slug, who = labels.get("awaiting"), labels.get("task"), labels.get("role")
    # Cleared whatever the turn said: an empty or failed turn owes nothing more, so the Desk
    # never shows "replying" for a reply that isn't coming.
    if awaiting:
        sh(["hc", "label", ME, "awaiting="])
    if not awaiting or not slug or not who:
        return
    what, _, since = awaiting.rpartition(":")
    if what.startswith("fresh"):
        # This turn wrote the handoff. The takeover ends this terminal, so it runs on its own.
        env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
        subprocess.Popen([SELF, "fresh", "--address", ME, "--take-over"], env=env, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    msg = msg.strip()
    if not msg:
        return
    # It posted by hand this turn after all: don't post twice.
    if any(r.get("address") == ME and r.get("kind") in ("say", "answer") and r.get("at", 0) >= int(since or 0)
           for r in chat_read(slug)[-30:]):
        return
    if what.startswith("ask-"):
        qid = what[4:]
        q = next((r for r in reversed(chat_read(slug)) if r.get("kind") == "ask" and r.get("id") == qid), None)
        asker = (q or {}).get("address")
        why = None
        if asker and terminal(asker).get("state") == "live":
            note = f"[desk chat] {who} answers {qid}: {msg}"
            if (terminal(asker).get("labels") or {}).get("role") == "cto":
                note += digest_for(slug, asker)
            why = send_text(asker, note)
        chat_append(slug, {"from": who, "address": ME, "kind": "answer", "re": qid, "to": [(q or {}).get("from")], "text": msg, "auto": True,
                           **({"delivered_to": [asker]} if asker and not why else {})})
    else:
        chat_append(slug, {"from": who, "address": ME, "kind": "say", "text": msg, "auto": True})


def permission_detail(inp):
    """The part of a tool call you decide on: the command, the file, the URL."""
    if not isinstance(inp, dict):
        return str(inp)[:600]
    for k in ("command", "file_path", "url", "query", "pattern", "path", "notebook_path"):
        if inp.get(k):
            return str(inp[k])[:600]
    return json.dumps(inp)[:600]


def rule_label(suggestions):
    """Claude's "Yes, and don't ask again for …" in words: the rules (or folders, or mode) it would save."""
    out = []
    for sug in suggestions if isinstance(suggestions, list) else []:
        if not isinstance(sug, dict):
            continue
        if sug.get("rules"):
            out += [f"{r.get('toolName')}({r['ruleContent']})" if r.get("ruleContent") else str(r.get("toolName"))
                    for r in sug["rules"] if isinstance(r, dict)]
        elif sug.get("directories"):
            out += [f"files in {os.path.basename(str(d).rstrip('/')) or d}/" for d in sug["directories"]]
        elif sug.get("mode"):
            out.append({"acceptEdits": "edits (accept them all)"}.get(sug["mode"], f"{sug['mode']} mode"))
    return ", ".join(out)[:200] or None


def permission_request():
    """Claude's PermissionRequest hook: the agent would ask in its terminal. A desk agent asks in the
    desk chat instead: a permission record, then a wait for team permit's answer file. No answer in
    time, any error, or not a desk agent: print nothing, and Claude asks in its terminal as usual.
    Nothing is ever allowed by default."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not ME:
        return
    labels = terminal(ME).get("labels", {}) or {}
    slug, who = labels.get("task"), labels.get("role")
    if not slug or not who:
        return
    suggestions = payload.get("permission_suggestions") or []
    pid = secrets.token_hex(4)
    path = os.path.join(PERMITS, f"{pid}.json")
    chat_append(slug, {"from": who, "address": ME, "kind": "permission", "id": pid, "tool": payload.get("tool_name") or "a tool",
                       "detail": permission_detail(payload.get("tool_input")), "always": rule_label(suggestions) if suggestions else None})
    decision, why, deadline, seen_blocked = None, "", time.time() + PERMIT_WAIT, False
    # Claude shows its terminal prompt while this waits, and answered there it kills this hook
    # outright (no signal to catch). A detached watcher records that, so the Desk drops the card.
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
    subprocess.Popen([SELF, "permit-watch", "--task", slug, "--id", pid, "--pid", str(os.getpid()), "--address", ME], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        while time.time() < deadline:
            try:
                with open(path) as f:
                    got = json.load(f)
                decision, why = got.get("decision"), str(got.get("message") or "")[:2000]
            except (OSError, ValueError, AttributeError):
                decision = None
            if decision in ("allow", "always", "deny"):
                break
            decision = None
            # Claude shows the same prompt in its terminal meanwhile (Herdr: blocked). Answered there,
            # the agent stops being blocked, and this request is over.
            state = ((terminal(ME).get("status") or {}).get("state")) if ME else None
            if state == "blocked":
                seen_blocked = True
            elif seen_blocked:
                break
            time.sleep(0.5)
    finally:
        try:
            os.remove(path)
        except OSError:
            pass
        chat_append(slug, {"from": "kabeer" if decision else who, "address": ME, "kind": "permission-done", "re": pid,
                           "decision": decision or "terminal"})
    if not decision:
        return
    if decision == "deny":
        out = {"behavior": "deny", "message": f"Kabeer said no from the desk chat: {why}" if why else
               "Kabeer said no from the desk chat. Don't retry it as is: say what you needed it for, or find another way."}
    else:
        out = {"behavior": "allow"}
        if decision == "always" and suggestions:
            out["updatedPermissions"] = suggestions
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": out}}))


def permit_watch(args):
    """Detached from a permission hook: once that hook is gone, if it never recorded an end
    (Claude killed it when the prompt was answered in its terminal), record it now."""
    stop = time.time() + PERMIT_TIMEOUT + 60
    while time.time() < stop:
        try:
            os.kill(args.pid, 0)
        except ProcessLookupError:
            break
        except PermissionError:
            pass
        time.sleep(0.5)
    else:
        return
    # A desk deleted meanwhile stays deleted: never recreate its thread for one line.
    if os.path.exists(chat_file(args.task)) and not any(r.get("kind") == "permission-done" and r.get("re") == args.id for r in chat_read(args.task)):
        chat_append(args.task, {"from": "kabeer", "address": args.address, "kind": "permission-done", "re": args.id, "decision": "terminal"})
    try:
        os.remove(os.path.join(PERMITS, f"{args.id}.json"))
    except OSError:
        pass


def permit(args):
    """The Desk's Allow / Always allow / Deny: answer a request its agent is still waiting on."""
    if not re.fullmatch(r"[0-9a-f]{8}", args.id):
        die(f"not a permission id: {args.id}")
    recs = chat_read(args.task)
    asked = next((r for r in recs if r.get("kind") == "permission" and r.get("id") == args.id), None)
    if not asked:
        die(f"no permission request {args.id} in {args.task}")
    if any(r.get("kind") == "permission-done" and r.get("re") == args.id for r in recs):
        die("that request isn't waiting any more (answered, or it asked in its terminal)")
    if args.decision == "always" and not asked.get("always"):
        die("Claude offered no rule to remember for this one: use allow")
    os.makedirs(PERMITS, exist_ok=True)
    path = os.path.join(PERMITS, f"{args.id}.json")
    with open(path + ".tmp", "w") as f:
        json.dump({"decision": args.decision, **({"message": args.message} if args.message else {})}, f)
    os.replace(path + ".tmp", path)  # whole or absent: the hook never reads half a file


def compacted():
    """Claude compacted this agent's context (SessionStart, source compact). Its record lands
    in the transcript just after this hook, so the size is read a moment later, apart."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not ME or not payload.get("transcript_path"):
        return
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
    subprocess.Popen([SELF, "measure", "--address", ME, "--transcript", payload["transcript_path"], "--compacted"], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def compact_meta(transcript):
    try:
        for line in tail_lines(transcript):
            if '"compact_boundary"' in line:
                return json.loads(line).get("compactMetadata")
    except (OSError, TypeError, ValueError):
        pass
    return None


def compact(args):
    """Types /compact into a Claude agent, as keys (hc send would paste it as a message)."""
    need_core()
    info = terminal(args.address)
    if info.get("state") != "live":
        die(f"{args.address} isn't a live terminal")
    role = next((r for r in load_roles() if r["id"] == (info.get("labels") or {}).get("role")), {})
    if role.get("cli") == "codex":
        die("compact is for Claude agents")
    status = (info.get("status") or {}).get("state")
    if status in ("working", "blocked"):
        die(f"it's {'working' if status == 'working' else 'waiting on you in its terminal'}; compact once its turn ends")
    keep = "keep the task and why decisions made files and commits touched next steps open questions and who is waiting"
    keys = ["/", *"compact", "space", *["space" if c == " " else c for c in keep], "enter"]
    r = sh(["hc", "keys", info.get("address") or args.address, *keys])
    if r.returncode != 0:
        die(f"couldn't type into it: {(r.stderr or r.stdout).strip()[:160]}")
    print(json.dumps({"ok": True}))


def measure(args):
    """(Claude's hook, detached) labels ctx=<tokens>; the first time past the role's limit, says so in the chat.
    After a compaction, its new size, and a line in the chat."""
    if args.compacted:
        meta, before = None, (terminal(args.address).get("labels") or {})
        for _ in range(20):
            time.sleep(0.75)
            meta = compact_meta(args.transcript)
            if meta:
                break
        # postTokens counts only the summarized history; the system prompt and tools still come on top,
        # so the new size is left to the next turn's measurement.
        meta = meta or {}
        pre = meta.get("preTokens") or before.get("ctx")
        sh(["hc", "label", args.address, "ctxwarned=", "ctx="])
        if before.get("task") and before.get("role"):
            size = f" (was {int(pre) // 1000}k tokens)" if pre else ""
            chat_append(before["task"], {"from": before["role"], "address": args.address, "kind": "compact",
                                         "trigger": meta.get("trigger"), "text": f"compacted its context{size}"})
        return
    ctx = None
    for _ in range(8):
        time.sleep(0.75)
        ctx = claude_context(args.transcript)
        if ctx and str(ctx) != (terminal(args.address).get("labels") or {}).get("ctx"):
            break
    if not ctx:
        return
    labels = terminal(args.address).get("labels") or {}
    slug, who = labels.get("task"), labels.get("role")
    warn = bool(slug and who and ctx >= fresh_at(who) and not labels.get("ctxwarned"))
    sh(["hc", "label", args.address, f"ctx={ctx}", *(["ctxwarned=1"] if warn else [])])
    if warn:
        chat_append(slug, {"from": who, "address": args.address, "kind": "context", "ctx": ctx,
                           "text": f"My context is at {ctx // 1000}k tokens, and every turn re-reads all of it. "
                                   "Compact it? I keep this session; the history becomes a summary."})


def tail_lines(path, size=4_000_000):
    """The end of a (possibly huge) transcript, newest line first."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - size))
        return reversed(f.read().decode("utf-8", "replace").splitlines())


def claude_context(transcript):
    """Tokens in a Claude agent's context now: its last main-thread call's prompt plus reply."""
    try:
        lines = tail_lines(transcript)
    except (OSError, TypeError):
        return None
    for line in lines:
        if '"compact_boundary"' in line:  # compacted since its last call: unknown until its next one
            return None
        if '"usage"' not in line:
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") != "assistant" or r.get("isSidechain"):
            continue
        u = (r.get("message") or {}).get("usage") or {}
        return sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")) or None
    return None


def last_text(transcript):
    """The newest assistant text in a Claude transcript (older Claude Codes' Stop input lacks it)."""
    try:
        with open(transcript) as f:
            lines = f.readlines()[-200:]
    except (OSError, TypeError):
        return ""
    for line in reversed(lines):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") == "assistant":
            parts = [c.get("text", "") for c in (r.get("message") or {}).get("content", []) if isinstance(c, dict) and c.get("type") == "text"]
            if any(parts):
                return "\n".join(parts)
    return ""


def chain_codex_notify(payload):
    """Our notify replaces the one in ~/.codex/config.toml for team agents, so call that one too."""
    try:
        import tomllib
        with open(os.path.expanduser("~/.codex/config.toml"), "rb") as f:
            prog = tomllib.load(f).get("notify")
        if isinstance(prog, list) and prog and SELF not in prog:
            subprocess.Popen(prog + list(payload[-1:]), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def inbox(args):
    slug = args.task or me_in_desk()[0]
    # Only a member of the desk moves its own read cursor; anyone else just reads.
    mine = bool(ME) and (terminal(ME).get("labels") or {}).get("task") == slug
    if args.all:
        recs = [r for r in chat_read(slug) if r.get("kind") != "desk"]
        if mine:
            unread(slug, ME)
    else:
        recs = unread(slug, ME) if mine else [r for r in chat_read(slug) if r.get("kind") != "desk"][-20:]
    print("\n".join(chat_line(r, 100000) for r in recs) or "(nothing new in the desk chat)")


def post(args):
    """Kabeer's message from the Desk chat: logged, then typed into each recipient.
    The CTO also gets what it hasn't seen yet in the chat."""
    text = " ".join(args.text).strip()
    if not text or not args.to:
        die("post needs --to ADDR:ROLE and a message")
    targets = [t.split(":", 1) if ":" in t else (t, t) for t in args.to]
    names = ", ".join(r for _, r in targets)
    delivered, delivered_to, failed = [], [], []
    for addr, role in targets:
        # Just a tag: how to answer is in every agent's system prompt (roles/protocol.md).
        note = f"[desk chat] Kabeer{f' (to {names})' if len(targets) > 1 else ''}: {text}"
        if role == "cto":
            note += digest_for(args.task, addr)
        why = send_text(addr, note)
        if why:
            failed.append({"role": role, "why": why})
        else:
            delivered.append(role); delivered_to.append(addr)
            expect_reply(addr, "chat")
    rec = chat_append(args.task, {"from": "kabeer", "kind": "say", "to": [r for _, r in targets], "text": text,
                                  "delivered": delivered, "delivered_to": delivered_to, "failed": failed})
    print(json.dumps(rec))


def new_desk(args):
    name = (args.name or "").strip()
    base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or f"desk-{time.strftime('%m%d-%H%M')}"
    os.makedirs(CHAT, exist_ok=True)
    slug, n = base, 2
    while os.path.exists(os.path.join(CHAT, f"{slug}.jsonl")):
        slug, n = f"{base[:36]}-{n}", n + 1
    folder = os.path.abspath(os.path.expanduser(args.repo)) if args.repo else None
    repo = repo_of(folder) if folder else None
    # Unnamed: the project and when, e.g. "tattvix · Nov 4 14:54", rather than the slug.
    label = name or " · ".join(x for x in ((repo or {}).get("name") or (os.path.basename(folder) if folder else None),
                                           time.strftime("%b %-d %H:%M")) if x)
    rec = chat_append(slug, {"from": "kabeer", "kind": "desk", "name": label, "folder": folder,
                             "project": repo["name"] if repo else (os.path.basename(folder) if folder else None)})
    print(json.dumps({"slug": slug, **rec}))


def git_out(cwd, *args):
    r = sh(["git", *args], cwd=cwd)
    return r.stdout.strip() if r.returncode == 0 else None


def finish(args):
    """Wraps up one agent. Anything left locally (uncommitted or untracked files, commits on no
    remote and not merged into the main checkout's branch) is flagged and nothing is removed.
    Otherwise a team worktree (~/.herdr/worktrees, team/* branch) is removed with plain
    `git worktree remove` and `git branch -d`, which git itself refuses on unsaved work.
    The main checkout is never removed. Then the agent's terminal is ended."""
    target = args.address or ME
    if not target:
        die("finish needs --address outside an hc terminal")
    need_core()
    info = terminal(target)
    if not info or info.get("state") != "live":
        die(f"{target} isn't a live terminal")
    target = info.get("address") or target  # a name was given: compare by address from here on
    labels = info.get("labels", {})
    who = labels.get("role") or info.get("name") or target
    slug = labels.get("task")
    status = (info.get("status") or {}).get("state")
    if status == "working" and not args.force:
        rec = chat_append(slug, {"from": who, "address": target, "kind": "flag",
                                 "text": "Still working, so not wrapped up. Wrap up again once it stops."})
        print(json.dumps({"finished": False, "why": "working", **rec}))
        return
    cwd = (info.get("foreground") or {}).get("cwd") or info.get("cwd")
    repo = repo_of(cwd) if cwd else None
    left, cleaned, notes = [], [], []
    if repo:
        top = repo["top"]
        branch = git_out(top, "rev-parse", "--abbrev-ref", "HEAD")
        dirty = [l for l in (git_out(top, "status", "--porcelain") or "").splitlines() if l.strip()]
        kept_commits = None
        if dirty:
            left.append(f"{len(dirty)} uncommitted or untracked file{'s' if len(dirty) != 1 else ''}")
        main_branch = git_out(repo["main"], "rev-parse", "--abbrev-ref", "HEAD")
        nots = ["--not", "--remotes"] + ([f"refs/heads/{main_branch}"] if main_branch and main_branch != branch else [])
        ahead = git_out(top, "rev-list", "--count", "HEAD", *nots)
        if ahead and ahead != "0" and top != repo["main"]:
            if args.keep_worktree:  # committed work is safe on its branch; only the agent goes
                kept_commits = f"{ahead} commit{'s' if ahead != '1' else ''} on {branch}"
            else:
                left.append(f"{ahead} commit{'s' if ahead != '1' else ''} on {branch} not pushed or merged into {main_branch}")
        team_worktree = top != repo["main"] and inside(top, WORKTREES) and (branch or "").startswith("team/")
        where = f"{repo['name']}" + (f" ({branch})" if branch else "")
        # A read-only role in the main checkout doesn't own what's there (likely Kabeer's own work).
        role = next((r for r in load_roles() if r["id"] == labels.get("role")), None)
        if left and top == repo["main"] and role and not role.get("worktree"):
            notes.append(f"{where} has " + "; ".join(left) + " (not this agent's, left as is)")
            left = []
        if left:
            text = f"Left locally in {where}: " + "; ".join(left) + ". Nothing removed."
            rec = chat_append(slug, {"from": who, "address": target, "kind": "flag", "text": text})
            sh(["hc", "label", target, "phase=blocked", f"note={text[:240]}"])
            print(json.dumps({"finished": False, "left": left, **rec}))
            return
        others = [t["address"] for t in live_terminals() if t["address"] != target and inside(
            ((terminal(t["address"]).get("foreground") or {}).get("cwd") or t.get("cwd")), top)] if team_worktree else []
        if args.keep_worktree:
            notes.append(f"kept worktree {os.path.basename(top)}" + (f" ({kept_commits})" if kept_commits else ""))
        elif team_worktree and others:
            notes.append(f"worktree {os.path.basename(top)} kept: {', '.join(others)} still works in it")
        elif team_worktree:
            r = sh(["git", "worktree", "remove", top], cwd=repo["main"])
            if r.returncode == 0:
                cleaned.append(f"removed worktree {os.path.basename(top)}")
                b = sh(["git", "branch", "-d", branch], cwd=repo["main"])
                cleaned.append(f"deleted branch {branch}" if b.returncode == 0 else f"kept branch {branch} (git: {b.stderr.strip()[:80]})")
            else:
                notes.append(f"worktree kept (git: {r.stderr.strip()[:120]})")
        elif top != repo["main"]:
            notes.append(f"worktree {top} isn't a team worktree, left as is")
    text = "Wrapped up: " + ("; ".join(cleaned + notes) if cleaned or notes else "nothing left locally") + "."
    rec = chat_append(slug, {"from": who, "address": target, "kind": "finish", "text": text})
    out = {"finished": True, "cleaned": cleaned, "notes": notes, **rec}
    print(json.dumps(out))
    sys.stdout.flush()
    if not args.keep_open:
        sh(["hc", "kill", target])
        for _ in range(20):  # so a wrap-up of the next agent sees this one gone
            if terminal(target).get("state") != "live":
                break
            time.sleep(0.15)


def handoff_path(cwd, slug, role_id):
    repo = repo_of(cwd) if cwd else None
    d = os.path.join(repo["common"], "team", "desks", slug) if repo else os.path.join(CHAT, f"{slug}.handoffs")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, f"handoff-{role_id}-{time.strftime('%m%d-%H%M%S')}.md")


def fresh(args):
    """A fresh session for an agent whose context got long. First the agent writes a handoff
    (what it's doing, done, next, open); when that turn ends, its hook runs --take-over: the
    same role starts in the same folder, tab and desk with the handoff as its first message,
    takes over the old one's place in the chat, and the old terminal is ended."""
    need_core()
    info = terminal(args.address)
    if info.get("state") != "live":
        die(f"{args.address} isn't a live terminal")
    addr, labels = info.get("address") or args.address, info.get("labels") or {}
    role_id, slug = labels.get("role"), labels.get("task")
    if not role_id or not slug:
        die("fresh is for desk agents (role and task labels)")
    cwd = (info.get("foreground") or {}).get("cwd") or info.get("cwd")
    if args.take_over:
        return take_over(info, addr, labels, role_id, slug, cwd)
    status = (info.get("status") or {}).get("state")
    if status == "working" and not args.force:
        die("it's working; start fresh once its turn ends (or pass --force)")
    path = handoff_path(cwd, slug, role_id)
    ctx = labels.get("ctx")
    why = send_text(addr, f"[desk] Your context is long{f' ({int(ctx) // 1000}k tokens)' if ctx else ''}, so a fresh session of you "
                          f"takes over when this turn ends. Write a handoff to {path}: what you're working on and why, what's done "
                          "(commits, files), what's next, open questions and who's waiting on what. Under 60 lines, facts only. "
                          "If you keep the decisions file, bring it up to date too. Then end your turn; start nothing new.")
    if why:
        die(f"couldn't reach it: {why}")
    sh(["hc", "label", addr, f"handoff={path}"])
    expect_reply(addr, "fresh")
    print(json.dumps({"ok": True, "handoff": path}))


def take_over(info, addr, labels, role_id, slug, cwd):
    role = next((r for r in load_roles() if r["id"] == role_id), {"name": role_id})
    path, ctx = labels.get("handoff"), labels.get("ctx")
    wrote = bool(path) and os.path.exists(path)
    task = (f"You're this desk's {role['name']}, taking over from your previous session, whose context got long. "
            + (f"Read its handoff in {path} first, then carry on" if wrote else
               f"It wrote no handoff, so read the decisions file and `{SELF} inbox --all`, then carry on")
            + " from where it left off. Don't redo finished work. If nothing is in flight, just say you're ready, in one line.")
    parent = info.get("parent")
    cmd = [SELF, "start", role_id, "--repo", cwd or os.path.expanduser("~"), "--share", "--slug", slug, "--requested",
           "--by", "fresh", "--task", task, "--fresh-of", addr,
           "--note", f"{role['name']} started fresh" + (f" (was {int(ctx) // 1000}k tokens)" if ctx else "")
           + (f". Handoff: `{path}`" if wrote else ". No handoff was written.")]
    cmd += ["--parent", parent] if parent and terminal(parent).get("state") == "live" else ["--no-parent"]
    for flag, key in (("--space", "herdr.space"), ("--tab", "herdr.tab")):
        if labels.get(key):
            cmd += [flag, labels[key]]
    r = sh(cmd)
    try:
        new = json.loads(r.stdout).get("address") if r.returncode == 0 else None
    except ValueError:
        new = None
    if not new:
        why = (r.stderr or r.stdout).strip()[:200]
        chat_append(slug, {"from": role_id, "address": addr, "kind": "flag",
                           "text": f"Couldn't start a fresh {role['name']} ({why}). The old session is still running."})
        sh(["hc", "label", addr, "handoff="])
        return
    # The new session reads the chat from where the old one stopped.
    try:
        with open(cursors_file(slug)) as f:
            cur = json.load(f)
    except (OSError, ValueError):
        cur = {}
    if addr in cur:
        cur[new] = cur.pop(addr)
        tmp = cursors_file(slug) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cur, f)
        os.replace(tmp, cursors_file(slug))
    sh(["hc", "kill", addr])
    print(json.dumps({"ok": True, "address": new, "replaced": addr, "handoff": path if wrote else None}))


def main():
    import argparse
    p = argparse.ArgumentParser(prog="team", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("role")
    s.add_argument("--repo"); s.add_argument("--brief"); s.add_argument("--task"); s.add_argument("--slug")
    s.add_argument("--parent"); s.add_argument("--no-parent", action="store_true")
    s.add_argument("--space"); s.add_argument("--requested", action="store_true"); s.add_argument("--by")
    s.add_argument("--share", action="store_true", help="work in --repo as is, never a new worktree")
    s.add_argument("--tab"); s.add_argument("--fresh-of"); s.add_argument("--note")
    r = sub.add_parser("report")
    r.add_argument("kind", choices=["done", "blocked", "update"])
    r.add_argument("text", nargs="+")
    y = sub.add_parser("say")
    y.add_argument("text", nargs="+")
    ak = sub.add_parser("ask")
    ak.add_argument("role"); ak.add_argument("text", nargs="+")
    ro = sub.add_parser("route")
    ro.add_argument("role"); ro.add_argument("text", nargs="+")
    hk = sub.add_parser("hook")
    hk.add_argument("cli", choices=["claude", "claude-compact", "claude-permission", "codex"]); hk.add_argument("payload", nargs="*")
    pm = sub.add_parser("permit")
    pm.add_argument("--task", required=True); pm.add_argument("id"); pm.add_argument("decision", choices=["allow", "always", "deny"])
    pm.add_argument("--message", help="with deny: tell it what to do instead")
    pw = sub.add_parser("permit-watch")
    pw.add_argument("--task", required=True); pw.add_argument("--id", required=True); pw.add_argument("--pid", type=int, required=True)
    pw.add_argument("--address", required=True)
    co = sub.add_parser("compact")
    co.add_argument("--address", required=True)
    an = sub.add_parser("answer")
    an.add_argument("id"); an.add_argument("text", nargs="+")
    ib = sub.add_parser("inbox")
    ib.add_argument("--task"); ib.add_argument("--all", action="store_true")
    q = sub.add_parser("post")
    q.add_argument("--task", required=True)
    q.add_argument("--to", action="append", default=[])
    q.add_argument("text", nargs="+")
    fi = sub.add_parser("finish")
    fi.add_argument("--address"); fi.add_argument("--keep-open", action="store_true")
    fi.add_argument("--keep-worktree", action="store_true", help="close the agent once nothing is uncommitted; keep its branch")
    fi.add_argument("--force", action="store_true", help="wrap up even while it's working")
    nd = sub.add_parser("new-desk")
    nd.add_argument("--name"); nd.add_argument("--repo")
    me_ = sub.add_parser("measure")
    me_.add_argument("--address", required=True); me_.add_argument("--transcript", required=True); me_.add_argument("--compacted", action="store_true")
    fr = sub.add_parser("fresh")
    fr.add_argument("--address", required=True); fr.add_argument("--force", action="store_true")
    fr.add_argument("--take-over", action="store_true", help=argparse.SUPPRESS)
    sub.add_parser("roles")
    args = p.parse_args()
    if args.cmd == "start":
        start(args)
    elif args.cmd == "report":
        report(args)
    elif args.cmd == "say":
        say(args)
    elif args.cmd == "ask":
        ask(args)
    elif args.cmd == "answer":
        answer(args)
    elif args.cmd == "route":
        route(args)
    elif args.cmd == "hook":
        hook(args)
    elif args.cmd == "permit":
        permit(args)
    elif args.cmd == "permit-watch":
        permit_watch(args)
    elif args.cmd == "inbox":
        inbox(args)
    elif args.cmd == "post":
        post(args)
    elif args.cmd == "finish":
        finish(args)
    elif args.cmd == "compact":
        compact(args)
    elif args.cmd == "measure":
        measure(args)
    elif args.cmd == "fresh":
        fresh(args)
    elif args.cmd == "new-desk":
        new_desk(args)
    else:
        print(json.dumps([{k: r.get(k) for k in ("id", "name", "cli", "model", "worktree", "on_request")} for r in load_roles()]))


if __name__ == "__main__":
    main()
