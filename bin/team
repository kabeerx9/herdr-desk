#!/usr/bin/env python3
"""team: start and report for the Desk's role agents (see mods/desk/roles.json).

  team start <role> [--repo DIR] [--brief FILE] [--task TEXT] [--slug SLUG]
                    [--parent T | --no-parent] [--space ID] [--requested] [--share] [--by WHO]
  team report <done|blocked|update> "<summary>"
  team say "<message>"                      post to your desk's chat (Markdown renders)
  team ask <role> "<question>"              ask someone in your desk; their reply comes back to you
  team route <role> "<Kabeer's question>"   (CTO) pass a question on; their reply goes to the chat
  team answer <id> "<answer>"               answer an ask by hand (replies are posted automatically)
  team inbox [--all]                        what's new in your desk's chat since you last looked
  team post --task SLUG --to ADDR:ROLE... "<message>"   (the Desk) Kabeer's chat message
  team post --raw --task SLUG --to ADDR:ROLE "/cmd"     (the Desk) typed exactly as is, e.g. a CLI slash command
  team finish [--address T] [--keep-worktree]  wrap up: flag leftovers, or remove the team worktree and close
  team hook claude|codex                    (the CLIs' end-of-turn hook) posts a reply the chat is waiting for
  team hook claude-permission               (Claude's PermissionRequest hook) asks in the desk chat, waits for Allow/Deny
  team permit --task SLUG <id> allow|always|deny [--message TEXT]   (the Desk's buttons) answer a pending permission request
  team approve --address T --choice allow|always|deny [--expect TEXT]   (the Desk) answer the permission prompt on its screen
  team approve --address T --peek           (the Desk) the permission prompt its screen shows, as JSON (exit 2: none)
  team new-desk [--name NAME] [--repo DIR]  a desk: an independent team with its own thread; prints its slug
  team join --task SLUG --address T --role R   (the Desk) bring an agent you started yourself into a desk
  team compact --address T                  a long context: Claude's /compact (same session, history summarized)
  team fresh --address T [--force]          or a new session: it writes a handoff, then a new one of it takes over
  team timeline --address T [--since-ms N]  what a Claude agent is doing this turn (from its transcript)
  team transcript --address T [--limit N]   one member's own conversation (Claude), newest N turn entries
  team settle|unsettle --address T          put an agent away until it works, blocks or reports done again
  team snooze --address T --until-ms N      the same, until a time
  team review-send --address T --file F     (the Desk) send a batch of review comments; empty = approved
  team gate --address T [--light "checked"] (CTO) may this engineer's branch be integrated? JSON verdict
  team cost [--task DESK] [--json]          tokens and API-rate dollars per agent, from each CLI's logs
  team roles

One launcher for everyone (the CTO, the Desk's buttons, you): it reads roles.json,
gives every editing role its own git worktree, and starts the role with hc in its own Herdr tab, labeled role=<id> task=<slug>.
Children always outlive their parent, so closing the CTO doesn't end its workers.
"""
import contextlib, fcntl, glob, io, json, os, re, secrets, shutil, subprocess, sys, time, shlex, uuid
from desk_runtime import Store as RuntimeStore, RuntimeError as DeskRuntimeError, adapter as runtime_adapter
from desk_runtime import attention as runtime_attention
from desk_runtime import find_queue as runtime_find_queue, queue_item as runtime_queue_item
from desk_runtime import foreground_agent, recover_interrupted_claims, reorder as runtime_reorder, session_view as runtime_session_view, upsert_session
from desk_runtime import (classify_launch_failure, codex_turns, codex_usage, find_codex_rollout, find_transcript, gate_verdict, light_gate_verdict, transcript_usage, parse_contract, parse_criteria, runner_variants,
                          session_cli, step_text, transcript_timeline, transcript_title, transcript_turns, triage_apply, triage_clear)
from desk_runtime import DIALOG_OPEN, NO_INPUT, cleared_transcript, command_result, screen_state
from desk_runtime import diff_stat, dialog_matches, permission_dialog, pick_option, task_line

APP = os.environ.get("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app")
DESK = os.path.join(APP, "mods", "desk")
WORKTREES = os.path.expanduser("~/.herdr/worktrees")
ME = os.environ.get("HC_TERMINAL_ID")
SELF = os.path.join(APP, "bin", "team")


def die(msg, code=1):
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


def sh(args, cwd=None, check=False):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"{' '.join(args[:3])}… failed: {(r.stderr or r.stdout).strip()}")
    return r


def hc_json(*args):
    r = sh(["hc", *args, "--json"])
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


FRESH_AT = 250_000  # roles.json "fresh_at" (or a role's own) overrides it


def roles_file():
    with open(os.path.join(DESK, "roles.json")) as f:
        return json.load(f)


def fresh_at(role_id):
    try:
        data = roles_file()
    except (OSError, ValueError):
        return FRESH_AT
    role = next((r for r in data.get("roles", []) if r.get("id") == role_id), {})
    return int(role.get("fresh_at") or data.get("fresh_at") or FRESH_AT)


def load_roles():
    roles = roles_file()["roles"]
    try:
        with open(os.path.join(DESK, "roles", "protocol.md")) as f:
            protocol = f.read().strip()
    except OSError:
        protocol = ""
    for r in roles:
        r.setdefault("id", r["name"].lower())
        text = ""
        if r.get("prompt"):
            with open(os.path.join(DESK, r["prompt"])) as f:
                text = f.read().strip()
        r["promptText"] = "\n\n".join(p for p in (text, protocol) if p)
    return roles


def adapter_config(role):
    config = {}
    if role.get("cli", "claude") == "claude" and not role.get("argv"):
        config = {"resume_args": ["--resume", "{session_id}"],
                  "fork_args": ["--resume", "{session_id}", "--fork-session"],
                  "session_args": ["--session-id", "{session_id}"]}
    config.update(role.get("adapter") or {})
    return config


def adapter_args(role, action, identity):
    values = adapter_config(role).get(action + "_args")
    if not isinstance(values, list) or not all(isinstance(x, str) for x in values):
        raise DeskRuntimeError("This CLI has no configured %s arguments" % action)
    return [x.replace("{session_id}", identity) for x in values]


def role_for_session(rec):
    return rec.get("role_config") or next((r for r in load_roles() if r["id"] == rec.get("role")), None)


def agent_identity(info):
    role_id = (info.get("labels") or {}).get("role")
    role = next((r for r in load_roles() if r["id"] == role_id), {})
    configured = (role.get("adapter") or {}).get("executable")
    return configured or (os.path.basename(role["argv"][0]) if role.get("argv") else role.get("cli"))


def is_agent(info):
    return bool(info and info.get("state") == "live" and foreground_agent(info, agent_identity(info)))


def argv_for(role, task):
    if isinstance(role.get("argv"), list):
        return role["argv"] + ([task] if task else [])
    prompt, extra, effort = role["promptText"], role.get("args", []), role.get("effort")
    if role.get("cli") not in (None, "claude", "codex"):
        die("Role %s uses %s; give it an argv list until that adapter is configured." % (role.get("name", role.get("id", "role")), role.get("cli")))
    if role.get("cli") == "codex":
        # --no-daemon: otherwise Codex runs its commands outside hc. -c parses TOML;
        # a JSON string is a valid TOML basic string, and a JSON list a TOML array.
        base = ["codex", "--no-daemon"] + (["-m", role["model"]] if role.get("model") else [])
        base += ["-c", f'model_reasoning_effort="{effort}"'] if effort else []
        # Codex's auto mode: the sandbox stays on, and a reviewer model answers its approval requests.
        base += ["--approve-for-me"] if role.get("permission_mode") == "auto" else []
        base += ["-c", "notify=" + json.dumps([SELF, "hook", "codex"])]
        base += ["-c", "developer_instructions=" + json.dumps(prompt)] if prompt else []
    else:
        # --tools first: it takes several values, so a value-less flag must follow it, never the task.
        # Fewer tools and no MCP servers keep every call's prompt small (measured 41k -> 17k tokens).
        base = ["claude"] + (["--tools", ",".join(role["tools"])] if role.get("tools") else [])
        base += [] if role.get("mcp") else ["--strict-mcp-config"]
        base += ["--model", role["model"]] if role.get("model") else []
        base += ["--effort", effort] if effort else []
        base += ["--permission-mode", role["permission_mode"]] if role.get("permission_mode") else []
        # Stop: post replies, measure context. PreToolUse: each tool call as one line of the agent's
        # activity feed (the Desk shows it while the agent works; no tokens spent).
        # SessionStart after a compaction (asked for or Claude's own): its new size.
        # PermissionRequest: what it would ask in its terminal, asked in the desk chat (team permit answers).
        # bash: in zsh, a bare `echo ====` is a failed =cmd lookup that stops the rest of the command.
        base += ["--settings", json.dumps({"env": {"CLAUDE_CODE_SHELL": "/bin/bash"}, "hooks": {
            "Stop": [{"hooks": [{"type": "command", "command": f"{SELF} hook claude", "timeout": 20}]}],
            "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": f"{SELF} hook claude-tool", "timeout": 10}]}],
            # UserPromptSubmit: the turn starts; snapshot the worktree for the Last turn review.
            "UserPromptSubmit": [{"hooks": [{"type": "command", "command": f"{SELF} hook claude-prompt", "timeout": 15}]}],
            "SessionStart": [{"matcher": "startup|resume|clear", "hooks": [{"type": "command", "command": f"{SELF} hook session", "timeout": 10}]}, {"matcher": "compact", "hooks": [{"type": "command", "command": f"{SELF} hook claude-compact", "timeout": 20}]}],
            "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "command", "command": f"{SELF} hook claude-permission", "timeout": PERMIT_TIMEOUT}]}]}})]
        base += ["--append-system-prompt", prompt] if prompt else []
    return base + extra + ([task] if task else [])


def repo_of(folder):
    top = sh(["git", "rev-parse", "--show-toplevel"], cwd=folder)
    common = sh(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=folder)
    if top.returncode or common.returncode:
        return None
    common = common.stdout.strip()
    main = common[:-5] if common.endswith("/.git") else common
    return {"top": top.stdout.strip(), "main": main, "common": common, "name": os.path.basename(main)}


def inside(path, d):
    return bool(path) and (path == d or path.startswith(d.rstrip("/") + "/"))


CHAT = os.path.expanduser("~/.herdr/team")
# Pending permission requests: the Desk's buttons (team permit) drop the answer here as <id>.json.
PERMITS = os.path.join(CHAT, ".permits")
# What each agent is doing right now, one line per tool call (team hook claude-tool), read by
# the Desk's chat while the agent works and cleared when its turn ends.
ACTIVITY = os.path.join(CHAT, ".activity")


def runtime_store():
    return RuntimeStore(CHAT)


def runtime_terminals():
    """Address keyed terminal facts; tolerated when the core is temporarily unavailable."""
    data = hc_json("ls") or {}
    items = data.get("terminals", []) if isinstance(data, dict) else data
    result = {}
    for item in items:
        if not isinstance(item, dict) or not item.get("address"):
            continue
        detail = terminal(item["address"])
        result[item["address"]] = detail or item
    return result


def runtime_record(address, role, task, cwd, cli, conversation=None, parent_task=None, capabilities=None, role_config=None, space=None, tab=None, **extra):
    """Record a launched/adopted role. Runtime state is private and never part of a repo."""
    if not address:
        return None
    store = runtime_store()
    git_repo = repo_of(cwd) if role_config and cwd else None
    return store.mutate(lambda data: dict(upsert_session(data, {"address": address, "role": role, "task": task, "cwd": cwd,
        "cli": cli or "claude", "conversation": conversation, "parent_task": parent_task, "capabilities": capabilities, "recovering": False,
        "role_config": role_config, "git_root": git_repo["top"] if git_repo else None, "space": space, "tab": tab, "at": int(time.time() * 1000),
        **extra})))


def activity_file(addr):
    return os.path.join(ACTIVITY, f"{addr}.jsonl")


def turn_mark(addr):
    return os.path.join(ACTIVITY, f"{addr}.turn")


def snapshot_turn(cwd):
    """The worktree as the turn starts, at refs/worktree/desk/turn-base (private index; the real
    index and files are untouched). Once per turn: the Stop hook clears the mark."""
    if not ME or not cwd:
        return
    try:
        os.makedirs(ACTIVITY, exist_ok=True)
        with open(turn_mark(ME), "w") as f:
            f.write(str(int(time.time() * 1000)))
        import desk_review
        desk_review.snapshot_turn(cwd)
    except Exception:
        pass  # not a git folder, or git failed: the Last turn view says there's no snapshot


def prompt_hook():
    """Claude's UserPromptSubmit hook. Prints nothing: its output would join the prompt."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    snapshot_turn((payload if isinstance(payload, dict) else {}).get("cwd") or os.getcwd())


def tool_step():
    """Claude's PreToolUse hook: append this call to the agent's activity feed. Quick; never blocks.
    The turn's first call also snapshots the worktree if the prompt hook didn't (no edit has run yet)."""
    if not ME:
        return
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            return
        if not os.path.exists(turn_mark(ME)):
            snapshot_turn(payload.get("cwd") or os.getcwd())
        rec = {"at": int(time.time() * 1000), "tool": payload.get("tool_name") or "?",
               "text": step_text(payload.get("tool_name") or "", payload.get("tool_input"))[:160]}
        os.makedirs(ACTIVITY, exist_ok=True)
        path = activity_file(ME)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec) + "\n")
        # Keep it short: the Desk shows the last few dozen at most.
        if os.path.getsize(path) > 32768:
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()[-80:]
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
    except (ValueError, OSError):
        return


def clear_activity(addr):
    for path in (activity_file(addr), turn_mark(addr)):
        try:
            os.remove(path)
        except OSError:
            pass
PERMIT_TIMEOUT = 600  # the hook's timeout in Claude's settings, seconds
PERMIT_WAIT = float(os.environ.get("TEAM_PERMIT_WAIT", PERMIT_TIMEOUT - 60))  # give up well before Claude kills it


def chat_file(slug):
    slug = re.sub(r"[^a-z0-9_-]+", "-", (slug or "untracked").lower()).strip("-") or "untracked"
    return os.path.join(CHAT, f"{slug}.jsonl")


@contextlib.contextmanager
def chat_lock(slug):
    """Appends and the one rewrite (desk_autoname) take this, so a rewrite never drops an append."""
    os.makedirs(CHAT, exist_ok=True)
    with open(chat_file(slug)[:-len(".jsonl")] + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def chat_append(slug, rec):
    """One thread per desk, outside any repo, since a desk can span several."""
    rec = {"at": int(time.time() * 1000), **rec}
    with chat_lock(slug), open(chat_file(slug), "a") as f:
        f.write(json.dumps(rec) + "\n")
    return rec


AUTO_NAME = re.compile(r"^(?:.+ · )?[A-Z][a-z]{2} \d{1,2} \d\d:\d\d$")


def desk_autoname(slug, title):
    """A desk nobody named ("tattvix · Nov 4 14:54") takes its CTO's session title, once.
    The first {kind:"desk"} line is rewritten under the chat lock; a named desk is left alone."""
    title = " ".join(str(title or "").split())[:80]
    path = chat_file(slug)
    if not title or not os.path.exists(path):
        return False
    with chat_lock(slug):
        with open(path) as f:
            first = f.readline()
            try:
                head = json.loads(first)
            except ValueError:
                return False
            if not isinstance(head, dict) or head.get("kind") != "desk" or head.get("named") \
                    or not (head.get("auto") or AUTO_NAME.match(str(head.get("name") or ""))):
                return False
            rest = f.read()
        head.update(name=title, named="title", auto=False)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(json.dumps(head) + "\n" + rest)
        os.replace(tmp, path)
    return True


def chat_read(slug):
    try:
        with open(chat_file(slug)) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def chat_line(r, width=800):
    who = "Kabeer" if r.get("from") == "kabeer" else r.get("from", "?")
    to = f" → {', '.join(r['to'])}" if r.get("to") else ""
    kind = "" if r.get("kind") == "say" else f" ({r.get('kind')})"
    text = (r.get("text") or "").strip()
    if len(text) > width:
        text = text[:width] + "… [cut; `team thread` has it all]"
    return f"[{time.strftime('%H:%M', time.localtime(r.get('at', 0) / 1000))}] {who}{to}{kind}: {text}"


def cursors_file(slug):
    return chat_file(slug)[:-len(".jsonl")] + ".cursors.json"


def unread(slug, address, advance=True):
    """Chat records `address` hasn't seen: after its cursor, not its own, not ones sent to it.
    One file per desk keeps each agent's cursor, so nothing repeats and nothing is skipped."""
    recs = chat_read(slug)
    try:
        with open(cursors_file(slug)) as f:
            cur = json.load(f)
    except (OSError, ValueError):
        cur = {}
    new = [r for r in recs[cur.get(address, 0):] if r.get("kind") != "desk" and r.get("address") != address
           and address not in (r.get("delivered_to") or [])]
    if advance:
        cur[address] = len(recs)
        tmp = cursors_file(slug) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cur, f)
        os.replace(tmp, cursors_file(slug))
    return new


def digest_for(slug, address, limit=20):
    new = unread(slug, address)
    if not new:
        return ""
    lines = [chat_line(r, 500) for r in new[-limit:]]
    more = f" ({len(new) - limit} earlier not shown; `{SELF} inbox --all` has everything)" if len(new) > limit else ""
    return "\n\nAlso new in the chat" + more + ":\n" + "\n".join(lines)


def desk_members(slug):
    """The desk's live agents, with their labels (hc ls filters by label but doesn't print them)."""
    d = hc_json("ls", "--label", f"task={slug}") or {}
    items = d.get("terminals", []) if isinstance(d, dict) else d
    out = []
    for t in items:
        if isinstance(t, dict) and t.get("state") == "live":
            info = terminal(t["address"])
            if (info.get("labels") or {}).get("role"):
                out.append({**t, "labels": info["labels"]})
    return out


def expect_reply(addr, what):
    """Marks a terminal as owing a reply; its end-of-turn hook posts that reply (team hook)."""
    return sh(["hc", "label", addr, f"awaiting={what}:{int(time.time() * 1000)}"]).returncode == 0


def role_label(info):
    """A terminal's role as the Desk names it ("CTO"), else its role id, else "It"."""
    role_id = (info.get("labels") or {}).get("role")
    try:
        role = next((r for r in roles_file().get("roles", []) if r.get("id", str(r.get("name", "")).lower()) == role_id), None)
    except (OSError, ValueError):
        role = None
    return (role or {}).get("name") or role_id or "It"


def screen_of(addr, history=0):
    r = sh(["hc", "read", "--lines", str(history), addr])
    return r.stdout if r.returncode == 0 else ""


def cli_of(info):
    """Which CLI draws this terminal's screen: what is running in it first (a runner list can
    start Codex for a role configured as Claude), else the role's configured CLI."""
    for cli in ("codex", "claude"):
        if foreground_agent(info, cli):
            return cli
    return "codex" if agent_identity(info) == "codex" else "claude"


def dialog_open(addr, info):
    """Why typing into this agent now would land in a dialog (Claude's /status, a picker), or None.
    Keys typed into a dialog answer it; the agent stays stuck until someone presses Esc."""
    state = screen_state(screen_of(addr), cli_of(info))
    return f"{role_label(info)} {DIALOG_OPEN}" if state["state"] == "dialog" else None


def send_text(addr, text):
    info = terminal(addr)
    if not is_agent(info):
        return "Recipient is disconnected or no longer running its configured agent"
    why = dialog_open(addr, info)
    if why:
        return why
    r = sh(["hc", "send", addr, text])
    if r.returncode == 0:
        return None
    why = (r.stderr or r.stdout).strip()
    try:
        why = json.loads(why)["error"]["message"]
    except (ValueError, KeyError, TypeError):
        pass
    return why[:160]


def live_terminals():
    d = hc_json("ls") or {}
    items = d.get("terminals", []) if isinstance(d, dict) else d
    return [t for t in items if isinstance(t, dict) and t.get("state") == "live"]


def terminal(t):
    return hc_json("get", t) or {}


def accept_trust(name, cli):
    """Answers the CLI's folder-trust prompt, for a worktree this script just made from a repo
    already in use. Claude's prompt defaults to "No, exit", so it needs down then enter."""
    for _ in range(40):
        # Once the agent reports a status it's past any trust prompt.
        st = terminal(name).get("status")
        if isinstance(st, dict) and st.get("state"):
            return False
        screen = sh(["hc", "read", "--lines", "0", name]).stdout
        if cli == "codex" and "Trust this folder?" in screen:
            sh(["hc", "keys", name, "enter"])
            return True
        if cli != "codex" and "Yes, I trust this folder" in screen:
            sh(["hc", "keys", name, "down", "enter"])
            return True
        time.sleep(0.5)
    return False


def add_worktree(repo, role):
    stamp = time.strftime("%m%d-%H%M%S")
    # The random part: two copies of a role can start in the same second.
    branch = f"team/{role['id']}-{stamp}-{secrets.token_hex(2)}"
    path = os.path.join(WORKTREES, repo["name"], re.sub(r"[^A-Za-z0-9._-]+", "-", branch))
    sh(["git", "worktree", "add", "-b", branch, path, "HEAD"], cwd=repo["top"], check=True)
    return path, branch


def unique_name(base):
    base = re.sub(r"[^a-z0-9_-]+", "-", base.lower()).strip("-")[:28] or "role"
    taken = {t.get("name") for t in live_terminals()}
    name, n = base, 2
    while name in taken:
        name, n = f"{base[:26]}-{n}", n + 1
    return name


def file_brief(path, role_id):
    """Moves a queued brief to team/sent/ so it's handed off once; returns where it went."""
    d = os.path.dirname(path)
    # team/briefs/<desk>/<role>.md, or the older team/briefs/<role>.md
    if os.path.basename(os.path.dirname(d)) == "briefs":
        d = os.path.dirname(d)
    elif os.path.basename(d) != "briefs":
        return path
    sent = os.path.join(os.path.dirname(d), "sent")
    os.makedirs(sent, exist_ok=True)
    dest = os.path.join(sent, f"{role_id}-{int(time.time() * 1000)}.md")
    shutil.move(path, dest)
    return dest


def rename_tab(tab, name):
    # The app sees a new labeled terminal within a moment; retry until its tab exists.
    for _ in range(12):
        r = sh(["herdr-app", "do", "tab.rename", json.dumps({"id": tab, "name": name})])
        try:
            if r.returncode == 0 and json.loads(r.stdout).get("ok"):
                return True
        except ValueError:
            pass
        time.sleep(0.25)
    return False


def start(args):
    roles = load_roles()
    role = next((r for r in roles if r["id"] == args.role or r["name"].lower() == args.role.lower()), None)
    if not role:
        die(f"no role {args.role!r}; known: {', '.join(r['id'] for r in roles)}")
    if role.get("on_request") and not args.requested:
        die(f"{role['name']} starts only when Kabeer asks for it. If Kabeer did, pass --requested.", 2)

    folder = os.path.abspath(os.path.expanduser(args.repo or os.getcwd()))
    need_core()
    me = terminal(ME) if ME else {}
    caller_labels = me.get("labels", {})
    # A brief in team/briefs/<desk>/ belongs to that desk.
    brief_desk = None
    if args.brief:
        bd = os.path.dirname(os.path.abspath(os.path.expanduser(args.brief)))
        if os.path.basename(os.path.dirname(bd)) == "briefs":
            brief_desk = os.path.basename(bd)
    slug = args.slug or caller_labels.get("task") or brief_desk or f"{role['id']}-{time.strftime('%m%d-%H%M')}"
    slug = re.sub(r"[^a-z0-9_-]+", "-", slug.lower()).strip("-")[:40]

    note, branch = None, None
    repo = repo_of(folder)
    # Editing roles always get their own worktree, so none starts in Kabeer's checkout or on main,
    # and two desks in one repo never share files.
    if role.get("worktree") and repo and not args.share:
        folder, branch = add_worktree(repo, role)
        note = f"own worktree on {branch} (from HEAD; uncommitted changes in {repo['name']} aren't in it)"

    task = args.task or ""
    contract, brief_text = None, None
    if args.brief:
        brief_path = os.path.abspath(os.path.expanduser(args.brief))
        try:
            with open(brief_path, encoding="utf-8") as f:
                brief_text = f.read()
                contract = parse_contract(brief_text)
        except (OSError, UnicodeDecodeError):
            contract = None
        brief = file_brief(brief_path, role["id"])
        task = (f"Your brief is in {brief}. Read it, then carry it out within the files and contract it gives you. "
                + task).strip()
    if task:
        task += f"\n\n(Team task: {slug}. Report with `{SELF} report done|blocked \"<summary>\"` when done or stuck.)"
    if task and contract and contract["acceptance"]:
        ids = ", ".join(x["id"] for x in contract["acceptance"])
        task += (f" Your done report must answer every acceptance criterion ({ids}): "
                 f"`--criteria '{{\"{contract['acceptance'][0]['id']}\":\"pass: how you know\"}}'` (pass, fail or n/a, each with a note), "
                 "and `--evidence verified` only if you ran every check yourself and saw it pass.")

    space = args.space or caller_labels.get("herdr.space") or "spteam" + secrets.token_hex(8)
    tab = args.tab or "tb" + secrets.token_hex(16)
    name = unique_name(f"{role['id']}-{slug}")
    cmd = ["hc", "run", "--bg", "--outlive-parent", "--name", name, "--cwd", folder,
           "--label", f"role={role['id']}", "--label", f"task={slug}", "--label", f"by={args.by or ME or 'shell'}",
           "--label", f"herdr.space={space}", "--label", f"herdr.tab={tab}"]
    initial_chat = getattr(args, "display_task", None)
    if initial_chat: cmd += ["--label", "awaiting=chat:" + str(int(time.time() * 1000))]
    cmd += ["--no-parent"] if args.no_parent else (["--parent", args.parent] if args.parent else [])
    # Through the user's own login + interactive shell: hc's environment lacks what ~/.zshrc sets
    # up (nvm's node and npm, Android tools). exec swaps the shell for the agent itself.
    shell = os.environ.get("SHELL") or "/bin/zsh"
    desk_note = f"\n\nYour desk is `{slug}`: your team chat and, for briefs, `team/briefs/{slug}/`."
    if repo:
        decisions = os.path.join(repo["common"], "team", "desks", slug, "decisions.md")
        desk_note += (f" The desk's decisions file is `{decisions}` (contracts, data model, what's done and left): "
                      + ("keep it current, rewritten not appended, under 100 lines." if role["id"] == "cto"
                         else "read it before you start, if it exists."))
    role = {**role, "promptText": role["promptText"] + desk_note}
    variants = runner_variants(role)
    fallbacks, trusted = [], None
    for n, variant in enumerate(variants):
        identity = str(uuid.uuid4()) if adapter_config(variant).get("session_args") else None
        command = argv_for(variant, "") + (adapter_args(variant, "session", identity) if identity else []) + ([task] if task else [])
        r = sh(cmd + ["--", shell, "-lic", 'exec "$@"', "team-role"] + command)
        if r.returncode != 0:
            die(f"hc run failed: {(r.stderr or r.stdout).strip()}")
        try:
            launched = json.loads(r.stdout)
        except ValueError:
            launched = {"raw": r.stdout.strip()}
        if len(variants) == 1:
            break
        # A runner list: watch the launch, and only a usage limit or a sign-in failure moves on.
        trusted = accept_trust(name, variant.get("cli")) if branch else None
        why = watch_launch(launched.get("address") or name, task)
        if not why or n == len(variants) - 1:
            if why:
                note = ((note + "; ") if note else "") + f"every runner failed ({why}); the last one is left open"
            break
        fallbacks.append({"cli": variant.get("cli"), "model": variant.get("model"), "why": why})
        sh(["hc", "kill", launched.get("address") or name]); sh(["hc", "rm", launched.get("address") or name])
    role = variant
    runtime_record(launched.get("address"), role["id"], slug, folder, role.get("cli"), identity,
                   capabilities={"resume": bool(adapter_config(role).get("resume_args")), "fork": bool(adapter_config(role).get("fork_args"))},
                   role_config=role, space=space, tab=tab, contract=contract, runner=role.get("runner"),
                   parent=None if args.no_parent else (args.parent or ME))
    if initial_chat:
        chat_append(slug, {"from": "kabeer", "kind": "say", "text": initial_chat,
                          "to": [role["id"]], "delivered": [role["id"]], "delivered_to": [launched.get("address")]})

    # The CTO that fans a task out is part of it too, so the Desk groups them.
    if ME and caller_labels.get("role") == "cto" and caller_labels.get("task") != slug:
        sh(["hc", "label", ME, f"task={slug}"])
    starter = caller_labels.get("role") or ("kabeer" if args.by == "desk" else (ME or "shell"))
    # What it was brought in to do, in one line, for the Desk's team card.
    line = task_line(args.task, brief_text)
    if args.fresh_of:
        chat_append(slug, {"from": role["id"], "kind": "fresh", "role": role["id"], "address": launched.get("address"),
                           "replaces": args.fresh_of, "text": args.note or f"{role['name']} started fresh"})
    else:
        fell = (f" ({fallbacks[-1]['cli']} failed with {fallbacks[-1]['why'].replace('_', ' ')}; running on {role.get('cli')})"
                if fallbacks else "")
        chat_append(slug, {"from": starter, "kind": "start", "role": role["id"], "address": launched.get("address"),
                           "text": f"Started {role['name']} in {os.path.basename(folder)}" + (f" on {branch}" if branch else "") + fell,
                           **({"task_line": line} if line else {}), **({"branch": branch} if branch else {}),
                           **({"contract": contract} if contract else {}), **({"runner": role["runner"], "fallbacks": fallbacks} if role.get("runner") else {})})
        if starter == "kabeer":
            tell_cto(slug, f"Kabeer added {role['name']} ({launched.get('address')}) to the desk"
                     + (f", working in {os.path.basename(folder)}" + (f" on {branch}" if branch else "") + "." if folder else "."),
                     skip=launched.get("address"))
    renamed = rename_tab(tab, role["name"])
    if len(variants) == 1:
        trusted = accept_trust(name, role.get("cli")) if branch else None
    startup_dialog = None
    if role.get("cli") == "codex" and launched.get("address"):
        startup_dialog = watch_startup_dialog(launched["address"])
        if startup_dialog:
            chat_append(slug, {"from": role["id"], "address": launched["address"], "kind": "command-note", "dialog": True,
                               "terminal": True, "startup": True, "why": startup_dialog, "text": f"{role['name']} {DIALOG_OPEN}"})
    print(json.dumps({"address": launched.get("address"), "name": name, "role": role["id"], "task": slug,
                      "cwd": folder, "branch": branch, "note": note, "tab": tab, "tab_named": renamed, "trust_accepted": trusted,
                      "startup_dialog": startup_dialog, "runner": role.get("runner"), "fallbacks": fallbacks, "contract": contract,
                      "hint": "A trust prompt in a new folder shows as 'Needs you'; its task runs once accepted."}))


RUNNER_WATCH = float(os.environ.get("TEAM_RUNNER_WATCH", 12))
STARTUP_DIALOG_S = float(os.environ.get("TEAM_STARTUP_DIALOG_WATCH", 6))


def watch_startup_dialog(address, seconds=None):
    """A just-started Codex member: what gave away a dialog on its screen (the hooks review, an
    approval) once it held for two reads in a row, or None. Bounded; ends early once it is working
    at its input line. Only reads the screen: nothing is pressed, trusted or dismissed. A screen
    without an input line alone (still drawing) is not enough here."""
    deadline, last = time.time() + (STARTUP_DIALOG_S if seconds is None else seconds), None
    while True:
        info = terminal(address)
        if info.get("state") and info.get("state") != "live":
            return None
        screen = screen_of(address)
        state = screen_state(screen, "codex")
        sure = state["state"] == "dialog" and state["why"] != NO_INPUT
        if sure and last == screen:
            return state["why"]
        if state["state"] == "prompt" and last == screen and (info.get("status") or {}).get("state") == "working":
            return None
        last = screen if sure or state["state"] == "prompt" else None
        if time.time() >= deadline:
            return None
        time.sleep(0.5)


def watch_launch(address, task, seconds=None):
    """A just-launched runner: "usage_limit" / "auth" when its screen says it can't run, else None
    (it worked a turn, it is still fine when the watch ends, or it exited for another reason)."""
    deadline, seen_working = time.time() + (RUNNER_WATCH if seconds is None else seconds), False
    while True:
        info = terminal(address)
        why = classify_launch_failure(sh(["hc", "read", "--lines", "200", address]).stdout, task)
        if why:
            return why
        if info.get("state") and info.get("state") != "live":
            return None
        state = (info.get("status") or {}).get("state")
        if state == "working":
            seen_working = True
        elif seen_working and state in ("idle", "done"):
            return None
        if time.time() >= deadline:
            return None
        time.sleep(0.5)


SANDBOX_HINT = ("hc can't reach herdr-core from here. If you're in a sandbox (Codex's blocks hc's socket), "
                "rerun this exact command with escalated permissions / outside the sandbox.")


def need_core():
    r = sh(["hc", "get", ME or "self", "--json"]) if ME else sh(["hc", "server", "status"])
    if r.returncode != 0:
        die(f"{SANDBOX_HINT} ({(r.stderr or r.stdout).strip()[:160]})", 3)


def report(args):
    if not ME:
        die("team report runs inside an hc terminal ($HC_TERMINAL_ID is unset)")
    need_core()
    me = terminal(ME)
    labels = me.get("labels", {})
    text = " ".join(args.text).strip()
    if not text:
        die("say what happened: team report done \"<what changed, what you verified>\"")
    store = runtime_store()
    try:
        mine = session_by_address(store.load(), ME) or {}
    except (DeskRuntimeError, OSError):
        mine = {}  # an unreadable registry never stops a report
    contract = mine.get("contract") or None
    criteria, evidence = None, getattr(args, "evidence", None) or "asserted"
    try:
        if getattr(args, "criteria", None):
            criteria = parse_criteria(args.criteria, contract)
        elif args.kind == "done" and contract and contract.get("acceptance"):
            die("your brief has acceptance criteria; report each one: --criteria '{"
                + ",".join(f'"{x["id"]}":"pass: note"' for x in contract["acceptance"]) + "}'", 2)
    except DeskRuntimeError as exc:
        die(str(exc), 2)
    blocking = getattr(args, "blocking", None)
    if blocking is not None and blocking < 0:
        die("--blocking is a count of blocking findings (0 or more)", 2)
    if args.kind == "done" and labels.get("role") == "reviewer" and blocking is None:
        die("a review's done report says how many findings block the merge: --blocking N (0 when none)", 2)
    cwd = (me.get("foreground") or {}).get("cwd") or me.get("cwd")
    head = getattr(args, "head", None) or (git_out(cwd, "rev-parse", "HEAD") if cwd and args.kind == "done" else None)
    lr = sh(["hc", "label", ME, f"phase={args.kind}", f"note={text[:240]}"])
    if lr.returncode != 0:
        die(f"couldn't record the report: {(lr.stderr or lr.stdout).strip()[:200]}", 3)
    who = labels.get("role") or me.get("name") or ME
    sent = False
    parent = me.get("parent")
    if not (parent and terminal(parent).get("state") == "live") and labels.get("task") and labels.get("role") != "cto":
        cto = next((t for t in desk_members(labels["task"]) if t["labels"]["role"] == "cto" and t["address"] != ME), None)
        parent = cto["address"] if cto else None
    extra = ""
    if criteria:
        extra += "\nCriteria: " + "; ".join(f"{c['id']} {c['result']}" + (f" ({c['note'][:80]})" if c["note"] else "") for c in criteria)
    if args.kind == "done":
        extra += f"\nEvidence: {evidence}" + (f". Blocking findings: {blocking}" if blocking is not None else "") + (f". HEAD {head[:10]}" if head else "")
    if parent:
        # Never typed into a dialog open in the parent's terminal: the chat record below still has it.
        why = dialog_open(parent, terminal(parent))
        r = None if why else sh(["hc", "send", parent, f"[{who} {args.kind}] {text}{extra}"])
        sent = bool(r) and r.returncode == 0
        if not sent:
            why = why or (r.stderr or r.stdout).strip()[:200]
            print(json.dumps({"warning": f"recorded, but not delivered to {parent}: {why}"}), file=sys.stderr)
    diff = diff_stat(cwd) if args.kind == "done" and cwd else None
    facts = {**({"criteria": criteria} if criteria else {}), **({"evidence": evidence} if args.kind == "done" else {}),
             **({"diff": {**diff, "cwd": cwd}} if diff else {}),
             **({"head": head} if head else {}), **({"blocking": blocking} if blocking is not None else {})}
    rec = chat_append(labels.get("task"), {"from": who, "address": ME, "kind": args.kind, "text": text, **facts,
                                           **({"delivered_to": [parent]} if sent else {})})
    if args.kind == "done" and mine:
        def record(data):
            session = session_by_address(data, ME)
            if session:
                session.update(evidence=evidence, evidence_at=rec["at"], criteria=criteria, last_done_head=head)
        try:
            store.mutate(record)
        except (DeskRuntimeError, OSError):
            pass
    print(json.dumps({"ok": True, "phase": args.kind, "sent_to_parent": parent if sent else None, **facts}))


def me_in_desk():
    if not ME:
        die("this runs inside an hc terminal ($HC_TERMINAL_ID is unset)")
    need_core()
    me = terminal(ME)
    labels = me.get("labels", {})
    return labels.get("task"), labels.get("role") or me.get("name") or ME


def say(args):
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    if not text:
        die("nothing to say")
    chat_append(slug, {"from": who, "address": ME, "kind": "say", "text": text})
    print(json.dumps({"ok": True, "task": slug}))


def ask(args):
    """A question to someone in the desk: one way, answered once with `team answer`,
    so agents never end up talking back and forth on their own."""
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    if not slug or not text:
        die("ask needs a desk (a task label) and a question")
    members = [t for t in desk_members(slug) if t.get("address") != ME]
    targets = [t for t in members if args.role in (t["labels"]["role"], t.get("address"))]
    if not targets:
        here = ", ".join(sorted({t["labels"]["role"] for t in members})) or "nobody else"
        die(f"no {args.role} in this desk (here: {here})")
    qid = "q" + secrets.token_hex(3)
    delivered, failed = [], []
    for t in targets:
        why = send_text(t["address"], f"[desk chat] {who} asks you ({qid}): {text}")
        if not why:
            expect_reply(t["address"], f"ask-{qid}")
        (failed.append({"role": t["labels"]["role"], "why": why}) if why else delivered.append(t["address"]))
    rec = chat_append(slug, {"from": who, "address": ME, "kind": "ask", "id": qid, "to": [targets[0]["labels"]["role"]],
                             "text": text, "delivered_to": delivered, "failed": failed})
    print(json.dumps({"id": qid, "delivered_to": delivered, "failed": failed, "at": rec["at"]}))


def answer(args):
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    q = next((r for r in reversed(chat_read(slug)) if r.get("kind") == "ask" and r.get("id") == args.id), None)
    if not q:
        die(f"no question {args.id} in this desk's chat")
    note = f"[desk chat] {who} answers {args.id}: {text}"
    asker = q.get("address")
    if (terminal(asker).get("labels") or {}).get("role") == "cto":
        note += digest_for(slug, asker)
    why = send_text(asker, note) if terminal(asker).get("state") == "live" else "the asker isn't running"
    chat_append(slug, {"from": who, "address": ME, "kind": "answer", "re": args.id, "to": [q.get("from")], "text": text,
                       **({"failed": [{"role": q.get("from"), "why": why}]} if why else {"delivered_to": [asker]})})
    print(json.dumps({"ok": not why, **({"warning": f"logged, not delivered: {why}"} if why else {})}))


def route(args):
    """The CTO passes Kabeer's question to whoever knows; their reply goes to the chat
    for Kabeer directly, so the CTO never rewrites it."""
    slug, who = me_in_desk()
    text = " ".join(args.text).strip()
    members = [t for t in desk_members(slug) if t.get("address") != ME] if slug else []
    targets = [t for t in members if args.role in (t["labels"]["role"], t.get("address"))]
    if not targets:
        here = ", ".join(sorted({t["labels"]["role"] for t in members})) or "nobody else"
        die(f"no {args.role} in this desk (here: {here})")
    t = targets[0]
    why = send_text(t["address"], f"[desk chat] Kabeer (via {who}): {text}")
    if not why:
        expect_reply(t["address"], "chat")
    chat_append(slug, {"from": who, "address": ME, "kind": "route", "to": [t["labels"]["role"]], "text": text,
                       **({"failed": [{"role": t["labels"]["role"], "why": why}]} if why else {"delivered_to": [t["address"]]})})
    print("passed on; the reply goes to the chat" if not why else f"not delivered: {why}")


def hook(args):
    """End of an agent's turn (Claude's Stop hook, Codex's notify). For Claude, records how big
    its context is now (the ctx label). When the turn answered a desk message, its final message is posted
    for it: the agent replies once, in its own words, and never types it again into `team say`.
    When the turn wrote a handoff (team fresh), a new session takes over. After a compaction
    (claude-compact, Claude's SessionStart hook), its new size. Quick; never blocks."""
    msg = ""
    wake_queue()
    if args.cli == "session":
        try:
            payload = json.load(sys.stdin)
            info = terminal(ME) if ME else {}; labels = info.get("labels") or {}
            identity = payload.get("session_id")
            if identity and labels.get("role") and labels.get("task"):
                runtime_record(ME, labels["role"], labels["task"], info.get("cwd"), labels.get("cli") or "claude", identity)
        except (ValueError, OSError, DeskRuntimeError):
            pass
        return
    if args.cli == "claude-compact":
        return compacted()
    if args.cli == "claude-permission":
        return permission_request()
    if args.cli == "claude-tool":
        return tool_step()
    if args.cli == "claude-prompt":
        return prompt_hook()
    try:
        if args.cli == "codex":
            payload = json.loads(args.payload[-1]) if args.payload else {}
            chain_codex_notify(args.payload)
            if payload.get("type") != "agent-turn-complete":
                return
            msg = payload.get("last-assistant-message") or ""
        else:
            payload = json.load(sys.stdin)
            msg = payload.get("last_assistant_message") or last_text(payload.get("transcript_path"))
            # Claude's transcript basename is its durable conversation identity. Keep it
            # only for the labeled Desk role that owns this hook; no unrelated scan.
            if ME and payload.get("transcript_path"):
                conversation = os.path.splitext(os.path.basename(payload["transcript_path"]))[0]
                labels_now = (terminal(ME).get("labels") or {})
                if labels_now.get("role") and labels_now.get("task"):
                    runtime_record(ME, labels_now["role"], labels_now["task"], terminal(ME).get("cwd"), "claude", conversation)
            # Claude writes the turn's usage just after this hook, so it's measured a moment later, apart.
            if ME and payload.get("transcript_path"):
                env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
                subprocess.Popen([SELF, "measure", "--address", ME, "--transcript", payload["transcript_path"]], env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except (ValueError, OSError):
        return
    if not ME:
        return
    clear_activity(ME)  # the turn's steps; its reply says what came of them
    labels = terminal(ME).get("labels", {})
    awaiting, slug, who = labels.get("awaiting"), labels.get("task"), labels.get("role")
    # Cleared whatever the turn said: an empty or failed turn owes nothing more, so the Desk
    # never shows "replying" for a reply that isn't coming.
    if awaiting:
        sh(["hc", "label", ME, "awaiting="])
    if not awaiting or not slug or not who:
        return
    what, _, since = awaiting.rpartition(":")
    if what.startswith("fresh"):
        # This turn wrote the handoff. The takeover ends this terminal, so it runs on its own.
        env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
        subprocess.Popen([SELF, "fresh", "--address", ME, "--take-over"], env=env, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    msg = msg.strip()
    if not msg:
        return
    # It posted by hand this turn after all: don't post twice.
    if any(r.get("address") == ME and r.get("kind") in ("say", "answer") and r.get("at", 0) >= int(since or 0)
           for r in chat_read(slug)[-30:]):
        return
    if what.startswith("ask-"):
        qid = what[4:]
        q = next((r for r in reversed(chat_read(slug)) if r.get("kind") == "ask" and r.get("id") == qid), None)
        asker = (q or {}).get("address")
        why = None
        if asker and terminal(asker).get("state") == "live":
            note = f"[desk chat] {who} answers {qid}: {msg}"
            if (terminal(asker).get("labels") or {}).get("role") == "cto":
                note += digest_for(slug, asker)
            why = send_text(asker, note)
        chat_append(slug, {"from": who, "address": ME, "kind": "answer", "re": qid, "to": [(q or {}).get("from")], "text": msg, "auto": True,
                           **({"delivered_to": [asker]} if asker and not why else {})})
    else:
        chat_append(slug, {"from": who, "address": ME, "kind": "say", "text": msg, "auto": True})


def permission_detail(inp):
    """The part of a tool call you decide on: the command, the file, the URL."""
    if not isinstance(inp, dict):
        return str(inp)[:600]
    for k in ("command", "file_path", "url", "query", "pattern", "path", "notebook_path"):
        if inp.get(k):
            return str(inp[k])[:600]
    return json.dumps(inp)[:600]


def rule_label(suggestions):
    """Claude's "Yes, and don't ask again for …" in words: the rules (or folders, or mode) it would save."""
    out = []
    for sug in suggestions if isinstance(suggestions, list) else []:
        if not isinstance(sug, dict):
            continue
        if sug.get("rules"):
            out += [f"{r.get('toolName')}({r['ruleContent']})" if r.get("ruleContent") else str(r.get("toolName"))
                    for r in sug["rules"] if isinstance(r, dict)]
        elif sug.get("directories"):
            out += [f"files in {os.path.basename(str(d).rstrip('/')) or d}/" for d in sug["directories"]]
        elif sug.get("mode"):
            out.append({"acceptEdits": "edits (accept them all)"}.get(sug["mode"], f"{sug['mode']} mode"))
    return ", ".join(out)[:200] or None


def permission_request():
    """Claude's PermissionRequest hook: the agent would ask in its terminal. A desk agent asks in the
    desk chat instead: a permission record, then a wait for team permit's answer file. No answer in
    time, any error, or not a desk agent: print nothing, and Claude asks in its terminal as usual.
    Nothing is ever allowed by default."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not ME:
        return
    labels = terminal(ME).get("labels", {}) or {}
    slug, who = labels.get("task"), labels.get("role")
    if not slug or not who:
        return
    suggestions = payload.get("permission_suggestions") or []
    pid = secrets.token_hex(4)
    path = os.path.join(PERMITS, f"{pid}.json")
    chat_append(slug, {"from": who, "address": ME, "kind": "permission", "id": pid, "tool": payload.get("tool_name") or "a tool",
                       "detail": permission_detail(payload.get("tool_input")), "always": rule_label(suggestions) if suggestions else None})
    decision, why, deadline, seen_blocked = None, "", time.time() + PERMIT_WAIT, False
    # Claude shows its terminal prompt while this waits, and answered there it kills this hook
    # outright (no signal to catch). A detached watcher records that, so the Desk drops the card.
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
    subprocess.Popen([SELF, "permit-watch", "--task", slug, "--id", pid, "--pid", str(os.getpid()), "--address", ME], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        while time.time() < deadline:
            try:
                with open(path) as f:
                    got = json.load(f)
                decision, why = got.get("decision"), str(got.get("message") or "")[:2000]
            except (OSError, ValueError, AttributeError):
                decision = None
            if decision in ("allow", "always", "deny"):
                break
            decision = None
            # Claude shows the same prompt in its terminal meanwhile (Herdr: blocked). Answered there,
            # the agent stops being blocked, and this request is over.
            state = ((terminal(ME).get("status") or {}).get("state")) if ME else None
            if state == "blocked":
                seen_blocked = True
            elif seen_blocked:
                break
            time.sleep(0.5)
    finally:
        try:
            os.remove(path)
        except OSError:
            pass
        chat_append(slug, {"from": "kabeer" if decision else who, "address": ME, "kind": "permission-done", "re": pid,
                           "decision": decision or "terminal"})
    if not decision:
        return
    if decision == "deny":
        out = {"behavior": "deny", "message": f"Kabeer said no from the desk chat: {why}" if why else
               "Kabeer said no from the desk chat. Don't retry it as is: say what you needed it for, or find another way."}
    else:
        out = {"behavior": "allow"}
        if decision == "always" and suggestions:
            out["updatedPermissions"] = suggestions
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": out}}))


def permit_watch(args):
    """Detached from a permission hook: once that hook is gone, if it never recorded an end
    (Claude killed it when the prompt was answered in its terminal), record it now."""
    stop = time.time() + PERMIT_TIMEOUT + 60
    while time.time() < stop:
        try:
            os.kill(args.pid, 0)
        except ProcessLookupError:
            break
        except PermissionError:
            pass
        time.sleep(0.5)
    else:
        return
    # A desk deleted meanwhile stays deleted: never recreate its thread for one line.
    if os.path.exists(chat_file(args.task)) and not any(r.get("kind") == "permission-done" and r.get("re") == args.id for r in chat_read(args.task)):
        chat_append(args.task, {"from": "kabeer", "address": args.address, "kind": "permission-done", "re": args.id, "decision": "terminal"})
    try:
        os.remove(os.path.join(PERMITS, f"{args.id}.json"))
    except OSError:
        pass


def permit(args):
    """The Desk's Allow / Always allow / Deny: answer a request its agent is still waiting on."""
    if not re.fullmatch(r"[0-9a-f]{8}", args.id):
        die(f"not a permission id: {args.id}")
    recs = chat_read(args.task)
    asked = next((r for r in recs if r.get("kind") == "permission" and r.get("id") == args.id), None)
    if not asked:
        die(f"no permission request {args.id} in {args.task}")
    if any(r.get("kind") == "permission-done" and r.get("re") == args.id for r in recs):
        die("that request isn't waiting any more (answered, or it asked in its terminal)")
    if args.decision == "always" and not asked.get("always"):
        die("Claude offered no rule to remember for this one: use allow")
    os.makedirs(PERMITS, exist_ok=True)
    path = os.path.join(PERMITS, f"{args.id}.json")
    with open(path + ".tmp", "w") as f:
        json.dump({"decision": args.decision, **({"message": args.message} if args.message else {})}, f)
    os.replace(path + ".tmp", path)  # whole or absent: the hook never reads half a file


def compacted():
    """Claude compacted this agent's context (SessionStart, source compact). Its record lands
    in the transcript just after this hook, so the size is read a moment later, apart."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not ME or not payload.get("transcript_path"):
        return
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
    subprocess.Popen([SELF, "measure", "--address", ME, "--transcript", payload["transcript_path"], "--compacted"], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def compact_meta(transcript):
    try:
        for line in tail_lines(transcript):
            if '"compact_boundary"' in line:
                return json.loads(line).get("compactMetadata")
    except (OSError, TypeError, ValueError):
        pass
    return None


def compact(args):
    """Types /compact into a Claude agent, as keys (hc send would paste it as a message)."""
    need_core()
    info = terminal(args.address)
    if info.get("state") != "live":
        die(f"{args.address} isn't a live terminal")
    role = next((r for r in load_roles() if r["id"] == (info.get("labels") or {}).get("role")), {})
    if role.get("cli") == "codex":
        die("compact is for Claude agents")
    status = (info.get("status") or {}).get("state")
    if status in ("working", "blocked"):
        die(f"it's {'working' if status == 'working' else 'waiting on you in its terminal'}; compact once its turn ends")
    why = dialog_open(info.get("address") or args.address, info)
    if why:
        die(why + "; close it there first")
    keep = "keep the task and why decisions made files and commits touched next steps open questions and who is waiting"
    keys = ["/", *"compact", "space", *["space" if c == " " else c for c in keep], "enter"]
    r = sh(["hc", "keys", info.get("address") or args.address, *keys])
    if r.returncode != 0:
        die(f"couldn't type into it: {(r.stderr or r.stdout).strip()[:160]}")
    print(json.dumps({"ok": True}))


def measure(args):
    """(Claude's hook, detached) labels ctx=<tokens>; the first time past the role's limit, says so in the chat.
    After a compaction, its new size, and a line in the chat."""
    if args.compacted:
        meta, before = None, (terminal(args.address).get("labels") or {})
        for _ in range(20):
            time.sleep(0.75)
            meta = compact_meta(args.transcript)
            if meta:
                break
        # postTokens counts only the summarized history; the system prompt and tools still come on top,
        # so the new size is left to the next turn's measurement.
        meta = meta or {}
        pre = meta.get("preTokens") or before.get("ctx")
        sh(["hc", "label", args.address, "ctxwarned=", "ctx="])
        if before.get("task") and before.get("role"):
            size = f" (was {int(pre) // 1000}k tokens)" if pre else ""
            chat_append(before["task"], {"from": before["role"], "address": args.address, "kind": "compact",
                                         "trigger": meta.get("trigger"), "text": f"compacted its context{size}"})
        return
    ctx = None
    for _ in range(8):
        time.sleep(0.75)
        ctx = claude_context(args.transcript)
        if ctx and str(ctx) != (terminal(args.address).get("labels") or {}).get("ctx"):
            break
    if not ctx:
        return
    labels = terminal(args.address).get("labels") or {}
    slug, who = labels.get("task"), labels.get("role")
    warn = bool(slug and who and ctx >= fresh_at(who) and not labels.get("ctxwarned"))
    sh(["hc", "label", args.address, f"ctx={ctx}", *(["ctxwarned=1"] if warn else [])])
    if warn:
        chat_append(slug, {"from": who, "address": args.address, "kind": "context", "ctx": ctx,
                           "text": f"My context is at {ctx // 1000}k tokens, and every turn re-reads all of it. "
                                   "Compact it? I keep this session; the history becomes a summary."})


def tail_lines(path, size=4_000_000):
    """The end of a (possibly huge) transcript, newest line first."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - size))
        return reversed(f.read().decode("utf-8", "replace").splitlines())


def claude_context(transcript):
    """Tokens in a Claude agent's context now: its last main-thread call's prompt plus reply."""
    try:
        lines = tail_lines(transcript)
    except (OSError, TypeError):
        return None
    for line in lines:
        if '"compact_boundary"' in line:  # compacted since its last call: unknown until its next one
            return None
        if '"usage"' not in line:
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") != "assistant" or r.get("isSidechain"):
            continue
        u = (r.get("message") or {}).get("usage") or {}
        return sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")) or None
    return None


def last_text(transcript):
    """The newest assistant text in a Claude transcript (older Claude Codes' Stop input lacks it)."""
    try:
        with open(transcript) as f:
            lines = f.readlines()[-200:]
    except (OSError, TypeError):
        return ""
    for line in reversed(lines):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") == "assistant":
            parts = [c.get("text", "") for c in (r.get("message") or {}).get("content", []) if isinstance(c, dict) and c.get("type") == "text"]
            if any(parts):
                return "\n".join(parts)
    return ""


def chain_codex_notify(payload):
    """Our notify replaces the one in ~/.codex/config.toml for team agents, so call that one too."""
    try:
        import tomllib
        with open(os.path.expanduser("~/.codex/config.toml"), "rb") as f:
            prog = tomllib.load(f).get("notify")
        if isinstance(prog, list) and prog and SELF not in prog:
            subprocess.Popen(prog + list(payload[-1:]), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def inbox(args):
    slug = args.task or me_in_desk()[0]
    # Only a member of the desk moves its own read cursor; anyone else just reads.
    mine = bool(ME) and (terminal(ME).get("labels") or {}).get("task") == slug
    if args.all:
        recs = [r for r in chat_read(slug) if r.get("kind") != "desk"]
        if mine:
            unread(slug, ME)
    else:
        recs = unread(slug, ME) if mine else [r for r in chat_read(slug) if r.get("kind") != "desk"][-20:]
    print("\n".join(chat_line(r, 100000) for r in recs) or "(nothing new in the desk chat)")


RAW_KEYS_MAX = 200


APPROVE_S = 3.0     # how long an answered permission prompt gets to close


def refuse(code, msg, **extra):
    """An approve that did nothing: JSON on stderr ({error, code, ...}), exit 2."""
    print(json.dumps({"error": msg, "code": code, **extra}), file=sys.stderr)
    sys.exit(2)


def approve_cli(addr, info):
    """The CLI really running there: its session's pinned runner, else the role's, else the program."""
    try:
        rec = session_by_address(runtime_store().load(), addr) or {}
    except (DeskRuntimeError, OSError):
        rec = {}
    cli = session_cli(rec) if rec else None
    fg = " ".join([str((info.get("foreground") or {}).get("name") or "")] + [str(x) for x in (info.get("foreground") or {}).get("argv") or []]).lower()
    if "codex" in fg:
        return "codex"
    return cli or agent_identity(info) or "claude"


def pending_permit(slug, addr):
    """The desk chat's permission request this agent's hook is still waiting on, or None."""
    if not slug:
        return None
    recs = chat_read(slug)
    done = {r.get("re") for r in recs if r.get("kind") == "permission-done"}
    for r in reversed(recs):
        if r.get("kind") == "permission" and r.get("address") == addr and r.get("id") and r["id"] not in done \
                and time.time() * 1000 - int(r.get("at") or 0) < PERMIT_WAIT * 1000 and r.get("source") != "screen":
            return r
    return None


def _same_prompt(a, b):
    return bool(a and b) and a["subject"] == b["subject"] and a["question"] == b["question"] \
        and [o["label"] for o in a["options"]] == [o["label"] for o in b["options"]]


def approve(args):
    """Answer the Claude permission prompt an agent's screen shows, from the Desk. It refuses unless
    a Claude permission prompt is showing and (with --expect) asks about exactly that command or
    file, so a stale click never answers a different prompt. The choice maps to the prompt's own
    option, read off the screen. A prompt the agent's PermissionRequest hook is also waiting on is
    answered through the hook (bound to its request id); otherwise the option's number is pressed.
    Then the screen is read again: done only once that prompt is gone."""
    addr = args.address
    info = terminal(addr)
    if not info or info.get("state") != "live":
        refuse("gone", "That agent isn't running any more")
    labels = info.get("labels") or {}
    name = role_label(info)
    cli = approve_cli(addr, info)
    if cli != "claude":
        refuse("unsupported", f"{name} runs {cli}: answer its prompt in its terminal", open_terminal=True)
    dialog = permission_dialog(screen_of(addr), "claude")
    if not dialog:
        refuse("no_prompt", f"{name} isn't showing a permission prompt any more", open_terminal=False)
    if getattr(args, "peek", False):
        hook = pending_permit(labels.get("task"), addr)
        print(json.dumps({"address": addr, "cli": cli, **dialog,
                          **({"hook": {"id": hook["id"], "tool": hook.get("tool"), "detail": hook.get("detail"), "always": hook.get("always")}} if hook else {})}))
        return
    choice = args.choice
    if choice not in ("allow", "always", "deny"):
        refuse("bad_choice", "choose allow, always or deny")
    if args.expect and not dialog_matches(dialog, args.expect):
        refuse("different", f"{name} is asking about something else now", showing=dialog["subject"][:400], open_terminal=True)
    option = pick_option(dialog, choice)
    if not option:
        refuse("no_option", f"This prompt has no “{ {'always': 'always allow', 'allow': 'allow', 'deny': 'deny'}[choice]}” option",
               options=[o["label"] for o in dialog["options"]], open_terminal=True)
    slug = labels.get("task")
    hook = pending_permit(slug, addr)
    via = "keys"
    if hook and (choice != "always" or hook.get("always")) and dialog_matches(dialog, hook.get("detail")):
        # The hook is waiting on this very prompt: answer it by id (it also saves Claude's rule for "always").
        os.makedirs(PERMITS, exist_ok=True)
        path = os.path.join(PERMITS, f"{hook['id']}.json")
        with open(path + ".tmp", "w") as f:
            json.dump({"decision": choice}, f)
        os.replace(path + ".tmp", path)
        via = "hook"
    else:
        hook = hook if hook and dialog_matches(dialog, hook.get("detail")) else None
        r = sh(["hc", "keys", addr, str(option["n"])])
        if r.returncode != 0:
            refuse("send_failed", f"Couldn't press {option['n']} in {name}'s terminal: {(r.stderr or r.stdout).strip()[:160]}", open_terminal=True)
    end, pressed_enter, after = time.time() + APPROVE_S, False, dialog
    while True:
        time.sleep(POLL_S)
        after = permission_dialog(screen_of(addr), "claude")
        if not _same_prompt(after, dialog):
            break
        # A select that only moved its focus onto our option: confirm it, once.
        focused = next((o for o in after["options"] if o["focused"]), None)
        if via == "keys" and not pressed_enter and focused and focused["n"] == option["n"]:
            sh(["hc", "keys", addr, "enter"]); pressed_enter = True
        if time.time() >= end:
            refuse("still_open", f"{name}'s prompt is still open after answering; check its terminal", open_terminal=True)
    if slug and os.path.exists(chat_file(slug)):
        if not hook:
            hook = chat_append(slug, {"from": labels.get("role") or name, "address": addr, "kind": "permission", "id": secrets.token_hex(4),
                                      "tool": dialog["title"] or "a tool", "detail": dialog["subject"][:600], "source": "screen"})
        if via == "keys":
            chat_append(slug, {"from": "kabeer", "address": addr, "kind": "permission-done", "re": hook["id"], "decision": choice, "via": "screen"})
    print(json.dumps({"ok": True, "address": addr, "choice": choice, "option": {"n": option["n"], "label": option["label"]}, "via": via,
                      "subject": dialog["subject"][:400], "next": after["subject"][:400] if after else None}))


def type_raw(addr, text):
    """Types text into an agent's terminal exactly as given. A short one-line slash command goes in
    as keys, so the CLI's own command menu reads it as typed (a paste can arrive as a message);
    anything else is pasted and submitted. Refuses a permission prompt: keys would answer it."""
    info = terminal(addr)
    if not is_agent(info):
        return "Recipient is disconnected or no longer running its configured agent"
    if (info.get("status") or {}).get("state") == "blocked":
        return "It's waiting on a prompt in its terminal; answer that first"
    state = screen_state(screen_of(addr), cli_of(info))
    if state["state"] == "dialog":
        return f"{role_label(info)} {DIALOG_OPEN}"
    if state["state"] == "prompt" and state["input"]:
        return f"{role_label(info)} has unsent text in its input; clear it in its terminal first"
    if text.startswith("/") and "\n" not in text and len(text) <= RAW_KEYS_MAX:
        keys = ["space" if c == " " else c for c in text] + ["enter"]
        r = sh(["hc", "keys", addr, *keys])
    else:
        r = sh(["hc", "send", addr, text])
    if r.returncode == 0:
        return None
    why = (r.stderr or r.stdout).strip()
    try:
        why = json.loads(why)["error"]["message"]
    except (ValueError, KeyError, TypeError):
        pass
    return why[:160] or "couldn't type into it"


SETTLE_S = 3.0      # how long an info command gets to print or open its dialog
ACCEPT_S = 2.0      # how long a typed command gets to leave the input box
POLL_S = 0.25
REPLY_COMMANDS = ("review",)   # prompt commands: the agent answers, and that answer goes to the chat


def watch_screen(addr, cli, done, timeout, history=60):
    """Reads the agent's screen every POLL_S until two reads in a row match and done(state, screen)
    holds (the screen settled on what we wait for), or the time is up. The state is judged on the
    visible part only (the last rows of the read). Returns (state, screen, settled)."""
    end, last = time.time() + timeout, None
    rows = max(10, int(terminal(addr).get("rows") or 40)) if history else 0
    while True:
        screen = screen_of(addr, history)
        state = screen_state("\n".join(screen.split("\n")[-rows:]) if rows else screen, cli)
        if screen == last and done(state, screen):
            return state, screen, True
        last = screen
        if time.time() >= end:
            return state, screen, False
        time.sleep(POLL_S)


def back_to_prompt(addr, cli, tries=2):
    """Esc out of whatever dialog is open, until Claude's empty input box is back. True when it is."""
    for _ in range(tries):
        sh(["hc", "keys", addr, "esc"])
        state, _, _ = watch_screen(addr, cli, lambda st, _s: st["state"] == "prompt" and not st["input"], 1.5, history=0)
        if state["state"] == "prompt" and not state["input"]:
            return True
    return False


def learn_cleared(addr, info, old, since_ms, timeout=3.0):
    """After /clear, the session the Desk reads (team transcript) is the new one. Claude's
    SessionStart hook (team hook session) records it for agents launched with it; older launches
    lack that hook, so the new transcript is found by its "/clear" record. Returns the new id."""
    labels = info.get("labels") or {}
    store = runtime_store()
    end = time.time() + timeout
    while True:
        now = (session_by_address(store.load(), addr) or {}).get("conversation")
        if now and now != old:
            return now
        path = find_transcript(old) if old else None
        fresh = cleared_transcript(os.path.dirname(path), old, since_ms) if path else None
        if fresh and labels.get("role") and labels.get("task"):
            runtime_record(addr, labels["role"], labels["task"], info.get("cwd"), "claude", fresh)
            return fresh
        if time.time() >= end:
            return None
        time.sleep(0.3)


def follow_command(task, addr, role, text, mode, since_ms, conversation=None):
    """What came of a typed command, posted to the desk chat so it doesn't vanish into the
    terminal. info: the printed result (its dialog captured, then closed). interactive: the
    terminal opens for Kabeer to use the picker. action: it left the input box; /clear and /new
    say so (and /clear points the Desk at the new conversation). Returns what the Desk does next."""
    info = terminal(addr)
    cli, name, command = cli_of(info), role_label(info), text.split(" ", 1)[0]
    out = {"peek": False, "cleared": False}

    def note(line, **extra):
        chat_append(task, {"from": role, "address": addr, "kind": "command-note", "command": command, "text": line, **extra})

    def peek(line):
        note(line, terminal=True); out["peek"] = True

    if mode == "info":
        def shown(st, screen):
            return st["state"] == "dialog" or (st["state"] == "prompt" and not st["input"] and command_result(screen, text) is not None)
        state, screen, _ = watch_screen(addr, cli, shown, SETTLE_S, history=120)
        dialog = state["state"] == "dialog"
        result = command_result(screen, text)
        restored = True if not dialog else back_to_prompt(addr, cli)
        chat_append(task, {"from": role, "address": addr, "kind": "command-result", "command": command,
                           "text": result or f"{name} printed nothing the Desk could read; its terminal has it.", "dialog": dialog})
        if not restored:
            peek(f"{name}'s terminal still shows a dialog after {command}; opened it so you can close it")
        return out
    if mode == "interactive":
        state, _, _ = watch_screen(addr, cli, lambda st, _s: st["state"] == "dialog", 1.5, history=0)
        peek(f"Opened {name}'s terminal for {command}" if state["state"] == "dialog"
             else f"Opened {name}'s terminal: {command} is there")
        return out
    left = lambda st, _s: st["state"] == "dialog" or (st["state"] == "prompt" and st["input"] != text)
    state, _, _ = watch_screen(addr, cli, left, ACCEPT_S, history=0)
    if state["state"] == "prompt" and state["input"] == text:
        sh(["hc", "keys", addr, "enter"])
        state, _, _ = watch_screen(addr, cli, left, ACCEPT_S, history=0)
    if state["state"] == "dialog":
        peek(f"{command} opened a dialog in {name}'s terminal; opened it for you")
    elif state["state"] == "prompt" and state["input"] == text:
        note(f"{name} didn't take {command}; it's still in its input", failed=True)
    elif command in ("/clear", "/new"):
        if cli == "claude":
            out["cleared"] = bool(learn_cleared(addr, info, conversation, since_ms))
        note(f"{name} started a new conversation")
    return out


def post_raw(args, text, targets):
    """A command from the Desk chat: typed exactly as given, no "[desk chat]" tag. Logged as kind
    "command"; then each recipient's outcome (follow_command) lands under it. Never types into an
    open dialog or over unsent text (type_raw refuses both). Prints the record plus "peek" (the
    terminals to open for Kabeer) and "cleared" (whose conversation is new)."""
    mode = getattr(args, "mode", None) or "action"
    name = text[1:].split(" ", 1)[0].lower() if text.startswith("/") else ""
    reply = name in REPLY_COMMANDS
    delivered, delivered_to, failed = [], [], []
    since = int(time.time() * 1000)
    # The conversation before typing: Claude's SessionStart hook can record the new one first.
    sessions = runtime_store().load()
    before = {addr: (session_by_address(sessions, addr) or {}).get("conversation") for addr, _ in targets}
    for addr, role in targets:
        labels = terminal(addr).get("labels") or {}
        if labels.get("task") != args.task or labels.get("role") != role:
            failed.append({"role": role, "address": addr, "why": "Recipient is disconnected or belongs to another desk."})
            continue
        if reply and not expect_reply(addr, "chat"):
            failed.append({"role": role, "address": addr, "why": "Could not reserve the reply; the command was not sent"})
            continue
        why = type_raw(addr, text)
        if why:
            if reply:
                sh(["hc", "label", addr, "awaiting="])
            failed.append({"role": role, "address": addr, "why": why, **({"dialog": True} if DIALOG_OPEN in why else {})})
        else:
            delivered.append(role); delivered_to.append(addr)
    rec = chat_append(args.task, {"from": "kabeer", "kind": "command", "to": [r for _, r in targets], "text": text, "mode": mode,
                                  "delivered": delivered, "delivered_to": delivered_to, "failed": failed})
    peek, cleared = [], []
    for addr, role in zip(delivered_to, delivered):
        try:
            out = follow_command(args.task, addr, role, text, mode, since, before.get(addr))
        except (OSError, ValueError, DeskRuntimeError):
            continue
        if out["peek"]: peek.append(addr)
        if out["cleared"]: cleared.append(addr)
    print(json.dumps({**rec, "peek": peek, "cleared": cleared}))
    if failed and not delivered:
        sys.exit(1)


def post(args):
    """Kabeer's message from the Desk chat: logged, then typed into each recipient.
    The CTO also gets what it hasn't seen yet in the chat."""
    text = " ".join(args.text).strip()
    if not text or not args.to:
        die("post needs --to ADDR:ROLE and a message")
    if getattr(args, "raw", False):
        return post_raw(args, text, [t.split(":", 1) if ":" in t else (t, t) for t in args.to])
    targets = [t.split(":", 1) if ":" in t else (t, t) for t in args.to]
    names = ", ".join(r for _, r in targets)
    delivered, delivered_to, failed = [], [], []
    for addr, role in targets:
        info = terminal(addr)
        labels = info.get("labels") or {}
        if not is_agent(info) or labels.get("task") != args.task or labels.get("role") != role:
            failed.append({"role": role, "why": "Recipient is disconnected or at a shell; use Resume or Queue next."})
            continue
        # Just a tag: how to answer is in every agent's system prompt (roles/protocol.md).
        note = f"[desk chat] Kabeer{f' (to {names})' if len(targets) > 1 else ''}: {text}"
        if role == "cto":
            note += digest_for(args.task, addr)
        if not expect_reply(addr, "chat"):
            failed.append({"role": role, "why": "Could not reserve the reply; message was not sent"})
            continue
        why = send_text(addr, note)
        if why:
            sh(["hc", "label", addr, "awaiting="])  # nothing was sent, so no reply is coming
            failed.append({"role": role, "address": addr, "why": why, **({"dialog": True} if DIALOG_OPEN in why else {})})
        else:
            delivered.append(role); delivered_to.append(addr)
    rec = chat_append(args.task, {"from": "kabeer", "kind": "say", "to": [r for _, r in targets], "text": text,
                                  "delivered": delivered, "delivered_to": delivered_to, "failed": failed})
    print(json.dumps(rec))


def tell_cto(slug, text, skip=None):
    """A heads-up to the desk's CTO, typed in now rather than left for its next inbox check.
    No reply is expected (nothing is marked awaiting)."""
    cto = next((t for t in desk_members(slug) if t["labels"].get("role") == "cto" and t["address"] not in (skip, ME)), None)
    if cto:
        send_text(cto["address"], f"[desk chat] {text} No reply needed.")
    return cto


def runtime_chats():
    records = []
    try:
        names = [x for x in os.listdir(CHAT) if x.endswith(".jsonl")]
    except OSError:
        return records
    for name in names:
        slug = name[:-6]
        thread = chat_read(slug)
        name = thread[0].get("name", slug) if thread else slug
        records.extend([{**row, "task": slug, "desk_name": name} for row in thread[-100:]])
    return records


def session_by_address(data, address):
    """The registry record for a terminal: the unfinished one, else the newest."""
    found = [x for x in data.get("sessions", []) if address and x.get("address") == address]
    found.sort(key=lambda x: (not x.get("finished"), x.get("at") or 0))
    return found[-1] if found else None


TITLES = lambda: os.path.join(CHAT, ".titles.json")


def session_title(rec):
    if session_cli(rec) != "claude" or not rec.get("conversation"):
        return None
    try:
        path = find_transcript(rec["conversation"])
        return transcript_title(path, TITLES()) if path else None
    except OSError:
        return None


def runtime_state(args):
    store = runtime_store(); data = store.load(); terminal_map = runtime_terminals()
    chats = runtime_chats(); now = int(time.time() * 1000)
    # Settled/snoozed agents come back on their own; decided here, where status and reports meet.
    if any(triage_clear(x, terminal_map.get(x.get("address")), chats, now) for x in data["sessions"]):
        def wake(value):
            for rec in value["sessions"]:
                triage_apply(rec, triage_clear(rec, terminal_map.get(rec.get("address")), chats, now))
        store.mutate(wake)
        data = store.load()
    if any(x.get("state") == "dispatching" for x in data["queue"]):
        with store.dispatch_lock():
            store.mutate(recover_interrupted_claims)
        data = store.load()
    if any(x.get("state") == "pending" for x in data["queue"]): wake_queue()
    records = [x for x in data["sessions"] if not args.task or x.get("task") == args.task]
    sessions = []
    for rec in records:
        view = runtime_session_view(rec, terminal_map)
        for key in ("settled_at", "snoozed_until", "evidence"):
            view.setdefault(key, None)
        view["title"] = session_title(rec)
        if view["title"] and rec.get("role") == "cto" and rec.get("task"):
            with contextlib.suppress(OSError):
                desk_autoname(rec["task"], view["title"])
        sessions.append(view)
    queue = [x for x in data["queue"] if not args.task or x.get("task") == args.task]
    print(json.dumps({"sessions": sessions, "queue": queue,
                      "attention": runtime_attention(data, terminal_map, chats)}))


def runtime_triage(args):
    """settle / unsettle / snooze one agent (by terminal address) in the runtime registry."""
    now = int(time.time() * 1000)
    if args.cmd == "snooze" and (args.until_ms is None or args.until_ms <= now):
        die("--until-ms must be a time in the future (ms since the epoch)")
    info = terminal(args.address) if args.cmd != "unsettle" else {}
    turn = info.get("turn") if isinstance(info.get("turn"), int) else None
    def change(data):
        rec = session_by_address(data, args.address)
        if not rec:
            raise DeskRuntimeError("No saved session has address %s" % args.address)
        if args.cmd == "settle":
            rec.update(settled_at=now, settled_turn=turn)
        elif args.cmd == "snooze":
            rec.update(snoozed_until=args.until_ms, snoozed_at=now, snoozed_turn=turn)
        else:
            triage_apply(rec, ["settled_at", "snoozed_until"])
        return {"address": rec["address"], "id": rec["id"], "settled_at": rec.get("settled_at"), "snoozed_until": rec.get("snoozed_until")}
    print(json.dumps(runtime_store().mutate(change)))


def runtime_timeline(args):
    rec = session_by_address(runtime_store().load(), args.address)
    if not rec:
        die("No saved session has address %s" % args.address)
    empty = {"address": args.address, "supported": False, "turn": None, "thought": None, "tools": None,
             "subagents": None, "context": None, "title": None}
    if session_cli(rec) != "claude":
        print(json.dumps({**empty, "reason": "%s doesn't write a transcript the Desk can read" % session_cli(rec)})); return
    path = find_transcript(rec.get("conversation"))
    if not path:
        print(json.dumps({**empty, "supported": True, "reason": "No transcript yet"})); return
    try:
        out = transcript_timeline(path, args.since_ms)
    except OSError as exc:
        die("Couldn't read the transcript: %s" % exc)
    if out["title"] is None:
        out["title"] = transcript_title(path, TITLES())
    # The transcript can end on prompts with no reply (a message that arrived while it was
    # stopping): Herdr's own status for the terminal decides whether the turn is still going.
    live = ((terminal(args.address).get("status") or {}).get("state"))
    if out.get("turn") and live is not None and live != "working":
        out["turn"]["working"] = False
    print(json.dumps({"address": args.address, **out}))


def runtime_transcript(args):
    """One member's own conversation (team transcript): see desk_runtime.transcript_turns."""
    rec = session_by_address(runtime_store().load(), args.address)
    if not rec:
        die("No saved session has address %s" % args.address)
    cli = session_cli(rec)
    if cli not in ("claude", "codex"):
        print(json.dumps({"address": args.address, "supported": False, "turns": [], "partial": False,
                          "reason": "%s doesn't write a transcript the Desk can read" % cli})); return
    path = find_codex_rollout(rec) if cli == "codex" else find_transcript(rec.get("conversation"))
    if not path:
        print(json.dumps({"address": args.address, "supported": True, "turns": [], "partial": False, "reason": "No transcript yet"})); return
    limit = args.limit if args.limit and args.limit > 0 else 120
    try:
        out = (codex_turns if cli == "codex" else transcript_turns)(path, min(limit, 500))
    except OSError as exc:
        die("Couldn't read the transcript: %s" % exc)
    print(json.dumps({"address": args.address, **out}))


REVIEW_MAX = 256 * 1024
REVIEW_PREFIX = "Fix each comment, then run the checks."
REVIEW_APPROVED = "Kabeer approved the changes."


def review_send(args):
    """The Desk's review batch to one agent. On any failure it exits nonzero and leaves the file."""
    try:
        size = os.path.getsize(args.file)
        if size > REVIEW_MAX:
            die(f"the review batch is {size // 1024} KiB; the limit is {REVIEW_MAX // 1024} KiB. Nothing was sent; it's still in {args.file}")
        with open(args.file, encoding="utf-8") as f:
            batch = f.read().strip()
    except (OSError, UnicodeDecodeError) as exc:
        die(f"couldn't read the review batch {args.file}: {exc}")
    info = terminal(args.address)
    addr, labels = info.get("address") or args.address, info.get("labels") or {}
    if not is_agent(info):
        die(f"{args.address} isn't running its agent (disconnected or at a shell). Nothing was sent; the batch is still in {args.file}")
    if (info.get("status") or {}).get("state") == "blocked":
        die(f"{labels.get('role') or addr} is waiting on a permission prompt. Answer it first; the batch is still in {args.file}")
    rec = session_by_address(runtime_store().load(), addr) or {}
    worktree = (info.get("foreground") or {}).get("cwd") or rec.get("cwd") or info.get("cwd")
    text = REVIEW_APPROVED if not batch else f"{REVIEW_PREFIX}\nWorktree: {worktree}\n\n{batch}"
    if not expect_reply(addr, "chat"):
        die(f"couldn't reserve its reply, so nothing was sent; the batch is still in {args.file}")
    why = send_text(addr, text)
    if why:
        sh(["hc", "label", addr, "awaiting="])
        die(f"not sent ({why}); the batch is still in {args.file}")
    role = labels.get("role") or rec.get("role")
    chat_append(labels.get("task") or rec.get("task"), {"from": "kabeer", "kind": "review", "to": [role], "text": text,
                "approved": not batch, "worktree": worktree, "delivered": [role], "delivered_to": [addr]})
    print(json.dumps({"ok": True, "address": addr, "approved": not batch, "bytes": len(text.encode("utf-8"))}))


def branch_files(cwd):
    """Files this branch changed since it left the default branch, or None if that can't be read."""
    if not cwd:
        return None
    default = (git_out(cwd, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "").strip()
    for ref in filter(None, (default, "main", "master")):
        base = git_out(cwd, "merge-base", "HEAD", ref)
        if base:
            names = git_out(cwd, "diff", "--name-only", base.strip(), "HEAD")
            return (names or "").split()
    return None


def session_usage(rec):
    """What one saved session spent, read from its CLI's own log; None if there's no log."""
    conversation = rec.get("conversation")
    if session_cli(rec) == "codex":
        path, read = find_codex_rollout(rec), codex_usage
    else:
        path, read = find_transcript(conversation), transcript_usage
    if not path:
        return None
    with open(path, encoding="utf-8", errors="replace") as f:
        return read(f)


def cost(args):
    """Tokens and API-rate dollars per agent, from each CLI's own logs."""
    rows = []
    for rec in runtime_store().load()["sessions"]:
        if args.task and rec.get("task") != args.task:
            continue
        usage = session_usage(rec)
        if usage and usage["calls"]:
            rows.append({"task": rec.get("task"), "role": rec.get("role"), "address": rec.get("address"),
                         "model": (usage["models"] or [(rec.get("role_config") or {}).get("model")])[0], **usage})
    if args.json:
        print(json.dumps(rows))
        return
    print("%-24s %-10s %-20s %6s %10s %10s %11s %8s %9s" % ("desk", "role", "model", "calls", "fresh in", "cache wr", "cache rd", "out", "API $"))
    for r in rows:
        print("%-24s %-10s %-20s %6d %10d %10d %11d %8d %9s" % (
            (r["task"] or "")[:24], r["role"] or "", (r["model"] or "")[:20], r["calls"], r["input"], r["cache_write"],
            r["cache_read"], r["output"], "n/a" if r["cost"] is None else "%.2f" % r["cost"]))
    priced = sum(r["cost"] or 0 for r in rows)
    print("Total at API rates: $%.2f (an estimate; Codex rows have no price)" % priced)


def runtime_gate(args):
    """The CTO's merge gate for one engineer: JSON verdict on stdout, exit 1 unless it's pass."""
    data = runtime_store().load()
    eng = session_by_address(data, args.address)
    if not eng:
        die("No saved session has address %s" % args.address)
    cwd = eng.get("cwd")
    head = git_out(cwd, "rev-parse", "HEAD") if cwd else None
    dirty = bool(git_out(cwd, "status", "--porcelain", "--untracked-files=no")) if head else False
    chats = [{**r, "task": r.get("task") or eng.get("task")} for r in chat_read(eng.get("task"))]
    light = getattr(args, "light", None)
    if light is not None:
        role = next((r for r in load_roles() if r["id"] == eng.get("role")), {})
        verdict = light_gate_verdict(eng, head, dirty, branch_files(cwd), light, bool(role.get("light_review")))
        if verdict["verdict"] == "pass":
            chat_append(eng.get("task"), {"from": "cto", "kind": "say", "text": "Skipped the Reviewer for %s: %s" % (role.get("name", eng.get("role")), light.strip())})
    else:
        verdict = gate_verdict(eng, data["sessions"], chats, head, dirty)
    print(json.dumps({"address": args.address, "role": eng.get("role"), "cwd": cwd,
                      "branch": git_out(cwd, "rev-parse", "--abbrev-ref", "HEAD") if head else None, **verdict}))
    if verdict["verdict"] != "pass":
        sys.exit(1)


def runtime_adopt(_args):
    terminal_map = runtime_terminals(); roles = {r["id"]: r for r in load_roles()}
    def adopt(data):
        adopted = []
        for address, info in terminal_map.items():
            labels = info.get("labels") or {}
            if not labels.get("role") or not labels.get("task"): continue
            role = roles.get(labels["role"], {})
            argv = (info.get("foreground") or {}).get("argv") or []
            cli = role.get("cli") or labels.get("cli") or "claude"
            identity = None
            for flag in ("--resume", "--session-id"):
                if flag in argv and argv.index(flag) + 1 < len(argv): identity = argv[argv.index(flag) + 1]
            existing = next((r for r in data["sessions"] if r.get("address") == address), {})
            config = adapter_config(role)
            record = upsert_session(data, {"address": address, "role": labels["role"], "task": labels["task"],
                "cwd": info.get("cwd"), "cli": cli, "conversation": existing.get("conversation") or identity,
                "role_config": existing.get("role_config") or role,
                "capabilities": {"resume": bool(config.get("resume_args")), "fork": bool(config.get("fork_args"))},
                "git_root": (repo_of(info.get("cwd")) or {}).get("top"),
                "space": labels.get("herdr.space"), "tab": labels.get("herdr.tab"), "at": existing.get("at") or int(time.time() * 1000)})
            adopted.append(runtime_session_view(record, terminal_map))
        return adopted
    print(json.dumps({"sessions": runtime_store().mutate(adopt)}))


def runtime_recover(args):
    store = runtime_store()
    def claim(data):
        rec = next((x for x in data["sessions"] if x["id"] == args.session), None)
        if not rec: raise DeskRuntimeError("That saved session no longer exists")
        if rec.get("recovering"): raise DeskRuntimeError("Recovery is already starting; check its terminal before retrying")
        view = runtime_session_view(rec, runtime_terminals())
        if view["state"] == "active": raise DeskRuntimeError("That session is already running")
        if not view["can_resume"]: raise DeskRuntimeError(view.get("reason") or "This session cannot be resumed")
        rec.update(recovering=True, recovery_at=int(time.time() * 1000))
        return dict(rec)
    rec = store.mutate(claim)
    def release():
        store.mutate(lambda data: next(x for x in data["sessions"] if x["id"] == args.session).update(recovering=False))
    role = role_for_session(rec)
    if not role:
        release(); die("This role has no saved launch configuration")
    try:
        command = argv_for(role, "") + adapter_args(role, "resume", rec["conversation"])
    except (DeskRuntimeError, SystemExit):
        release(); raise
    info = terminal(rec.get("address"))
    shell_names = {"zsh", "bash", "sh", "fish", "nu", "dash", "ksh"}
    foreground = (info or {}).get("foreground") or {}
    argv = foreground.get("argv") or []
    executable = os.path.basename(argv[0]) if argv else foreground.get("name")
    if info and info.get("state") == "live":
        if executable not in shell_names:
            release(); die("This terminal is occupied; recovery never replaces a running program")
        result = sh(["hc", "send", rec["address"], "exec " + shlex.join(command)])
        if result.returncode:
            # A transport error may follow a successful send: never inject a retry.
            die("Recovery delivery is uncertain. Check the terminal before retrying.")
        address = rec["address"]
    else:
        space = rec.get("space") or "spteam" + secrets.token_hex(8)
        tab = rec.get("tab") or "tb" + secrets.token_hex(16)
        shell = os.environ.get("SHELL") or "/bin/zsh"
        launch = ["hc", "run", "--bg", "--outlive-parent", "--cwd", rec["cwd"], "--no-parent",
            "--label", "role=" + rec["role"], "--label", "task=" + rec["task"],
            "--label", "herdr.space=" + space, "--label", "herdr.tab=" + tab,
            "--", shell, "-lic", 'exec "$@"', "team-role"] + command
        result = sh(launch)
        if result.returncode: die("Recovery launch is uncertain. Check live terminals before retrying.")
        try: address = json.loads(result.stdout)["address"]
        except (ValueError, KeyError): die("Recovery launch returned no terminal identity; check live terminals before retrying.")
        def remap(data):
            record = next(x for x in data["sessions"] if x["id"] == rec["id"])
            old = record["address"]; record.update(address=address, space=space, tab=tab)
            for item in data["queue"]:
                if item["state"] == "pending":
                    for target in item["targets"]:
                        if target["address"] == old: target["address"] = address
        store.mutate(remap)
    print(json.dumps({"address": address, "task": rec["task"], "session": rec["id"]}))


def wake_queue():
    store = runtime_store()
    if not any(x.get("state") == "pending" for x in store.load()["queue"]): return
    with store.watch_lock() as available:
        if not available: return
    # Release the probe lock before the child tries to acquire the singleton lock.
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"}
    subprocess.Popen([SELF, "queue-watch"], env=env, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def runtime_queue(args):
    targets = []
    for value in args.to:
        address, role = value.split(":", 1) if ":" in value else (value, value)
        info = terminal(address); labels = info.get("labels") or {}
        if labels.get("task") != args.task or labels.get("role") != role:
            die("Queue recipient does not belong to this desk and role")
        target = {"address": address, "role": role, "cli": agent_identity(info)}
        if target not in targets: targets.append(target)
    item = runtime_store().mutate(lambda data: dict(runtime_queue_item(data, args.task, " ".join(args.text), targets)))
    wake_queue()
    print(json.dumps(item))


def runtime_queue_edit(args):
    text = (args.text if isinstance(args.text, str) else " ".join(args.text or [])).strip()
    if not text: die("Queued text cannot be empty")
    def edit(data):
        item = runtime_find_queue(data, args.id)
        if item["state"] != "pending": raise DeskRuntimeError("Only a pending message can be edited")
        item["text"] = text; return dict(item)
    print(json.dumps(runtime_store().mutate(edit)))


def runtime_queue_move(args):
    def move(data):
        item = runtime_find_queue(data, args.id)
        if item["state"] != "pending": raise DeskRuntimeError("Only a pending message can be reordered")
        items = sorted([x for x in data["queue"] if x["state"] == "pending" and x["task"] == item["task"]], key=lambda x: x["position"])
        place = items.index(item) + (-1 if args.direction == "up" else 1)
        if 0 <= place < len(items):
            here = items.index(item); items[here], items[place] = items[place], items[here]
        for n, value in enumerate(items): value["position"] = n
        return dict(item)
    print(json.dumps(runtime_store().mutate(move)))


def runtime_queue_cancel(args):
    def cancel(data):
        item = runtime_find_queue(data, args.id)
        if item["state"] not in ("pending", "failed", "uncertain"):
            raise DeskRuntimeError("Only a pending or failed message can be dismissed")
        item["state"] = "cancelled"; runtime_reorder(data); return dict(item)
    print(json.dumps(runtime_store().mutate(cancel)))


def runtime_queue_dispatch_locked(store, _args):
    # The caller owns Store.dispatch_lock for this entire snapshot/claim/send
    # transition. Do not move terminal_map outside that critical section.
    terminal_map = runtime_terminals()
    def claim(data):
        recover_interrupted_claims(data)
        # Keep FIFO per recipient while allowing other projects to make progress.
        reserved = set()
        for item in sorted(data["queue"], key=lambda q: q.get("position", 0)):
            if item.get("state") != "pending": continue
            addresses = {t["address"] for t in item["targets"]}
            if addresses & reserved: continue
            ready = True
            for target in item["targets"]:
                info = terminal_map.get(target["address"])
                labels = (info or {}).get("labels") or {}
                if not is_agent(info) or labels.get("task") != item["task"] or labels.get("role") != target["role"]:
                    item.update(state="failed", error="Recipient is disconnected or belongs to a different desk; message was not sent")
                    return dict(item)
                state = (info.get("status") or {}).get("state")
                if state not in ("idle", "done") or labels.get("awaiting"): ready = False
                # A dialog open in its terminal would swallow the message: wait until it's closed.
                elif dialog_open(target["address"], info): ready = False
            if not ready:
                reserved.update(addresses); continue
            item["state"] = "dispatching"; item["claimed_at"] = int(time.time() * 1000)
            return dict(item)
        return None

    claimed = store.mutate(claim)
    if not claimed: print(json.dumps({"state": "waiting"})); return
    if claimed.get("state") != "dispatching": print(json.dumps(claimed)); return
    failures = []
    for target in claimed["targets"]:
        if not expect_reply(target["address"], "chat"):
            why = "Could not reserve its reply; this recipient was not sent the message"
            outcome = "not_sent"
        else:
            why = send_text(target["address"], "[desk chat] Kabeer: " + claimed["text"])
            # A dialog opened since the claim: nothing was typed, so it waits for the dialog to close.
            outcome = "not_sent" if why and DIALOG_OPEN in why else "uncertain" if why else "sent"
            if outcome == "not_sent": sh(["hc", "label", target["address"], "awaiting="])
        if why: failures.append({"role": target["role"], "why": why, **({"dialog": True} if DIALOG_OPEN in why else {})})
        def record_delivery(data):
            item = runtime_find_queue(data, claimed["id"])
            item.setdefault("deliveries", {})[target["address"]] = {"state": outcome, "error": why}
        store.mutate(record_delivery)
    def finish(data):
        item = runtime_find_queue(data, claimed["id"])
        if failures and len(failures) == len(claimed["targets"]) and all(x.get("dialog") for x in failures):
            # Nobody got it and every refusal was a dialog: keep it queued until they close.
            item.update(state="pending", error="; ".join(x["why"] for x in failures))
            item.pop("claimed_at", None); item.pop("deliveries", None)
        elif failures: item.update(state="uncertain", error="; ".join(x["why"] for x in failures))
        else:
            item["state"] = "delivered"
            chat_append(item["task"], {"from": "kabeer", "kind": "say", "to": [x["role"] for x in item["targets"]],
                                        "text": item["text"], "delivered": [x["role"] for x in item["targets"]],
                                        "delivered_to": [x["address"] for x in item["targets"]], "queued": True, "failed": []})
        return dict(item)
    print(json.dumps(store.mutate(finish)))


def runtime_queue_dispatch(args):
    store = runtime_store()
    with store.dispatch_lock():
        runtime_queue_dispatch_locked(store, args)


def runtime_queue_watch(_args):
    """One bounded dispatcher; later agent hooks or GUI reads rearm it."""
    store = runtime_store()
    with store.watch_lock() as available:
        if not available: return
        deadline = time.monotonic() + 20 * 60
        while time.monotonic() < deadline:
            if not any(x.get("state") == "pending" for x in store.load()["queue"]): return
            runtime_queue_dispatch(_args)
            time.sleep(3)


def runtime_attention_dismiss(args):
    def dismiss(data):
        if args.id not in data["dismissed"]: data["dismissed"].append(args.id)
        return {"dismissed": args.id}
    print(json.dumps(runtime_store().mutate(dismiss)))


def runtime_side(args):
    """Create an independent read-only discussion desk. It never interrupts the source agent."""
    store = runtime_store(); data = store.load(); terminal_map = runtime_terminals()
    rec = next((x for x in data["sessions"] if x["id"] == args.session), None)
    if not rec: die("That saved session no longer exists")
    view = runtime_session_view(rec, terminal_map)
    if args.kind == "fork":
        return runtime_fork(args, rec, view)
    if not args.text or not args.text.strip(): die("A side conversation needs a question")
    base = "side-" + re.sub(r"[^a-z0-9]+", "-", rec.get("task", "desk"))[:28]
    slug, number = base, 2
    os.makedirs(CHAT, exist_ok=True)
    while os.path.exists(os.path.join(CHAT, slug + ".jsonl")):
        slug = base[:36] + "-" + str(number); number += 1
    chat_append(slug, {"from": "kabeer", "kind": "desk", "name": "Side · " + rec.get("task", "Desk"),
                       "folder": rec.get("cwd"), "project": os.path.basename(rec.get("cwd") or ""),
                       "parent_task": rec.get("task"), "parent_session": rec["id"]})
    role = role_for_session(rec)
    if not role: die("This role has no saved launch configuration")
    # A side discussion is explicitly read-only. It starts independently, so the
    # original role keeps its terminal, context and task untouched.
    prompt = "Side conversation only. Do not edit files, run mutations, start agents, push, or open a PR. Answer this question: " + args.text.strip()
    launch = type("Args", (), {"role": role["id"], "repo": rec.get("cwd") or os.getcwd(), "brief": None, "task": prompt,
                                 "slug": slug, "parent": None, "no_parent": True, "space": None, "requested": True,
                                 "by": "desk", "share": True, "tab": None, "fresh_of": None, "note": None, "display_task": args.text.strip()})()
    output = io.StringIO()
    with contextlib.redirect_stdout(output): start(launch)
    started = json.loads(output.getvalue())
    print(json.dumps({"task": slug, "address": started.get("address"), "parent_task": rec.get("task")}))


def runtime_fork(args, rec, view):
    """Fork Claude's saved context into an owned git worktree.

    The original terminal stays untouched. If creating the owned worktree or
    launching its terminal fails, clean only that newly-created worktree/branch.
    """
    if not view.get("can_fork"):
        die(view.get("fork_reason") or "This session cannot create an isolated fork")
    repo = repo_of(rec.get("cwd") or "")
    if not repo: die("Fork needs a git repository so it can isolate file changes in a worktree")
    role = role_for_session(rec)
    if not role: die("This role has no saved launch configuration")
    slug_base = "fork-" + re.sub(r"[^a-z0-9]+", "-", rec.get("task", "desk"))[:28]
    slug, number = slug_base, 2
    while os.path.exists(os.path.join(CHAT, slug + ".jsonl")):
        slug = slug_base[:36] + "-" + str(number); number += 1
    stamp = time.strftime("%m%d-%H%M%S")
    branch = "team/fork-%s-%s-%s" % (role["id"], stamp, secrets.token_hex(3))
    path = os.path.join(WORKTREES, repo["name"], branch.replace("/", "-"))
    made = False; launched = False
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        added = sh(["git", "worktree", "add", "-b", branch, path, "HEAD"], cwd=repo["top"])
        if added.returncode: die("Couldn't create isolated fork worktree: " + (added.stderr or added.stdout).strip())
        made = True
        space, tab = "spteam" + secrets.token_hex(8), "tb" + secrets.token_hex(16)
        name = unique_name("%s-%s" % (role["id"], slug))
        fork_role = {**role, "promptText": role.get("promptText", "") + "\n\nThis is an isolated conversation fork. Your current desk is " + slug + ". Work only in " + path + "; do not replay the previous task. The original desk remains unchanged."}
        command = argv_for(fork_role, "") + adapter_args(fork_role, "fork", rec["conversation"]) + ([args.text] if args.text else [])
        shell = os.environ.get("SHELL") or "/bin/zsh"
        launch = ["hc", "run", "--bg", "--outlive-parent", "--name", name, "--cwd", path,
                  "--label", "role=" + role["id"], "--label", "task=" + slug, "--label", "by=desk",
                  "--label", "herdr.space=" + space, "--label", "herdr.tab=" + tab,
                  "--no-parent", "--", shell, "-lic", 'exec "$@"', "team-role", *command]
        result = sh(launch)
        if result.returncode: die("Couldn't launch context fork: " + (result.stderr or result.stdout).strip())
        launched = True
        try: started = json.loads(result.stdout)
        except ValueError: started = {}
        chat_append(slug, {"from": "kabeer", "kind": "desk", "name": "Fork · " + rec.get("task", "Desk"),
                           "folder": path, "project": repo["name"], "parent_task": rec.get("task"), "parent_session": rec["id"]})
        chat_append(slug, {"from": "kabeer", "kind": "start", "role": role["id"], "address": started.get("address"),
                           "text": "Started isolated context fork on " + branch})
        if not started.get("address"): die("Fork may be running, but its address was not returned. Its worktree was preserved: " + path)
        # Copy display context without copying actionable permission prompts.
        for message in chat_read(rec["task"])[-50:]:
            if message.get("kind") in ("say", "done", "blocked", "update", "ask", "answer"):
                copied = {k: v for k, v in message.items() if k not in ("address", "failed", "delivered_to")}
                chat_append(slug, {**copied, "copied_from": rec["task"]})
        if args.text:
            chat_append(slug, {"from": "kabeer", "kind": "say", "text": args.text, "to": [role["id"]], "delivered": [role["id"]], "delivered_to": [started["address"]]})
            expect_reply(started["address"], "chat")
        session = runtime_record(started.get("address"), role["id"], slug, path, rec.get("cli"), None, rec.get("task"),
            capabilities={"resume": bool(adapter_config(fork_role).get("resume_args")), "fork": bool(adapter_config(fork_role).get("fork_args"))},
            role_config=fork_role, space=space, tab=tab)
        rename_tab(tab, role["name"] + " fork")
        print(json.dumps({"task": slug, "address": started.get("address"), "session": session.get("id") if session else None,
                          "parent_task": rec.get("task"), "branch": branch, "cwd": path}))
    except SystemExit:
        if made and not launched:
            sh(["git", "worktree", "remove", path], cwd=repo["top"])
            sh(["git", "branch", "-D", branch], cwd=repo["top"])
        raise
    except Exception:
        if made and not launched:
            sh(["git", "worktree", "remove", path], cwd=repo["top"])
            sh(["git", "branch", "-D", branch], cwd=repo["top"])
        raise


def join(args):
    """Brings a terminal Kabeer started outside the desk (a plain `claude` in a tab) into a desk: labels it
    role/task like a started member, tells it how the desk works, and tells the CTO."""
    need_core()
    info = terminal(args.address)
    if not info or info.get("state") != "live":
        die(f"{args.address} isn't a live terminal")
    addr = info.get("address") or args.address
    labels = info.get("labels") or {}
    if labels.get("role") and labels.get("task"):
        die(f"{addr} is already in desk {labels['task']}")
    if not os.path.exists(os.path.join(CHAT, f"{args.task}.jsonl")):
        die(f"no desk {args.task}")
    role = next((r for r in load_roles() if r["id"] == args.role), None)
    if not role:
        die(f"no role {args.role}")
    if role["id"] == "cto" and any(t["labels"].get("role") == "cto" for t in desk_members(args.task)):
        die("this desk has a CTO already")
    r = sh(["hc", "label", addr, f"role={role['id']}", f"task={args.task}", "by=kabeer"])
    if r.returncode != 0:
        die(f"couldn't label {addr}: {(r.stderr or r.stdout).strip()[:160]}")
    # It wasn't started by team, so it has no end-of-turn hook: its replies aren't posted for it.
    note = (f"[desk chat] Kabeer added you to desk `{args.task}` as {role['name']}. The team tool is `{SELF}` "
            f"and the protocol is `{os.path.join(DESK, 'roles', 'protocol.md')}`: read it once. One difference for you: "
            f"you joined mid-session, so your replies are NOT posted to the chat for you. Answer Kabeer's `[desk chat]` "
            f"messages with `team say \"...\"`, another agent's question with `team answer <id> \"...\"`, and use "
            f"`team report done|blocked \"...\"` when you finish or get stuck. No reply needed to this message.")
    why = send_text(addr, note)
    rec = chat_append(args.task, {"from": "kabeer", "kind": "start", "role": role["id"], "address": addr,
                                  "text": f"Added {role['name']} ({addr}), an agent started outside the desk"})
    cto = tell_cto(args.task, f"Kabeer added {role['name']} ({addr}) to the desk: an agent Kabeer started outside the desk, "
                              f"so it replies with `team say` rather than automatically. Reach it with `team ask {role['id']}`.",
                   skip=addr) if role["id"] != "cto" else None
    print(json.dumps({**rec, "told": why is None, "told_cto": bool(cto)}))


def new_desk(args):
    name = (args.name or "").strip()
    base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or f"desk-{time.strftime('%m%d-%H%M')}"
    os.makedirs(CHAT, exist_ok=True)
    slug, n = base, 2
    while os.path.exists(os.path.join(CHAT, f"{slug}.jsonl")):
        slug, n = f"{base[:36]}-{n}", n + 1
    folder = os.path.abspath(os.path.expanduser(args.repo)) if args.repo else None
    repo = repo_of(folder) if folder else None
    # Unnamed: the project and when, e.g. "tattvix · Nov 4 14:54", rather than the slug.
    label = name or " · ".join(x for x in ((repo or {}).get("name") or (os.path.basename(folder) if folder else None),
                                           time.strftime("%b %-d %H:%M")) if x)
    rec = chat_append(slug, {"from": "kabeer", "kind": "desk", "name": label, "auto": not name, "folder": folder,
                             "project": repo["name"] if repo else (os.path.basename(folder) if folder else None)})
    print(json.dumps({"slug": slug, **rec}))


def git_out(cwd, *args):
    r = sh(["git", *args], cwd=cwd)
    return r.stdout.strip() if r.returncode == 0 else None


def finish(args):
    """Wraps up one agent. Anything left locally (uncommitted or untracked files, commits on no
    remote and not merged into the main checkout's branch) is flagged and nothing is removed.
    Otherwise a team worktree (~/.herdr/worktrees, team/* branch) is removed with plain
    `git worktree remove` and `git branch -d`, which git itself refuses on unsaved work.
    The main checkout is never removed. Then the agent's terminal is ended."""
    target = args.address or ME
    if not target:
        die("finish needs --address outside an hc terminal")
    need_core()
    info = terminal(target)
    if not info or info.get("state") != "live":
        die(f"{target} isn't a live terminal")
    target = info.get("address") or target  # a name was given: compare by address from here on
    labels = info.get("labels", {})
    who = labels.get("role") or info.get("name") or target
    slug = labels.get("task")
    status = (info.get("status") or {}).get("state")
    if status == "working" and not args.force:
        rec = chat_append(slug, {"from": who, "address": target, "kind": "flag",
                                 "text": "Still working, so not wrapped up. Wrap up again once it stops."})
        print(json.dumps({"finished": False, "why": "working", **rec}))
        return
    cwd = (info.get("foreground") or {}).get("cwd") or info.get("cwd")
    repo = repo_of(cwd) if cwd else None
    left, cleaned, notes = [], [], []
    if repo:
        top = repo["top"]
        branch = git_out(top, "rev-parse", "--abbrev-ref", "HEAD")
        dirty = [l for l in (git_out(top, "status", "--porcelain") or "").splitlines() if l.strip()]
        kept_commits = None
        if dirty:
            left.append(f"{len(dirty)} uncommitted or untracked file{'s' if len(dirty) != 1 else ''}")
        main_branch = git_out(repo["main"], "rev-parse", "--abbrev-ref", "HEAD")
        nots = ["--not", "--remotes"] + ([f"refs/heads/{main_branch}"] if main_branch and main_branch != branch else [])
        ahead = git_out(top, "rev-list", "--count", "HEAD", *nots)
        if ahead and ahead != "0" and top != repo["main"]:
            if args.keep_worktree:  # committed work is safe on its branch; only the agent goes
                kept_commits = f"{ahead} commit{'s' if ahead != '1' else ''} on {branch}"
            else:
                left.append(f"{ahead} commit{'s' if ahead != '1' else ''} on {branch} not pushed or merged into {main_branch}")
        team_worktree = top != repo["main"] and inside(top, WORKTREES) and (branch or "").startswith("team/")
        where = f"{repo['name']}" + (f" ({branch})" if branch else "")
        # A read-only role in the main checkout doesn't own what's there (likely Kabeer's own work).
        role = next((r for r in load_roles() if r["id"] == labels.get("role")), None)
        if left and top == repo["main"] and role and not role.get("worktree"):
            notes.append(f"{where} has " + "; ".join(left) + " (not this agent's, left as is)")
            left = []
        if left:
            text = f"Left locally in {where}: " + "; ".join(left) + ". Nothing removed."
            rec = chat_append(slug, {"from": who, "address": target, "kind": "flag", "text": text})
            sh(["hc", "label", target, "phase=blocked", f"note={text[:240]}"])
            print(json.dumps({"finished": False, "left": left, **rec}))
            return
        others = [t["address"] for t in live_terminals() if t["address"] != target and inside(
            ((terminal(t["address"]).get("foreground") or {}).get("cwd") or t.get("cwd")), top)] if team_worktree else []
        if args.keep_worktree:
            notes.append(f"kept worktree {os.path.basename(top)}" + (f" ({kept_commits})" if kept_commits else ""))
        elif team_worktree and others:
            notes.append(f"worktree {os.path.basename(top)} kept: {', '.join(others)} still works in it")
        elif team_worktree:
            r = sh(["git", "worktree", "remove", top], cwd=repo["main"])
            if r.returncode == 0:
                cleaned.append(f"removed worktree {os.path.basename(top)}")
                b = sh(["git", "branch", "-d", branch], cwd=repo["main"])
                cleaned.append(f"deleted branch {branch}" if b.returncode == 0 else f"kept branch {branch} (git: {b.stderr.strip()[:80]})")
            else:
                notes.append(f"worktree kept (git: {r.stderr.strip()[:120]})")
        elif top != repo["main"]:
            notes.append(f"worktree {top} isn't a team worktree, left as is")
    text = "Wrapped up: " + ("; ".join(cleaned + notes) if cleaned or notes else "nothing left locally") + "."
    rec = chat_append(slug, {"from": who, "address": target, "kind": "finish", "text": text})
    out = {"finished": True, "cleaned": cleaned, "notes": notes, **rec}
    print(json.dumps(out))
    sys.stdout.flush()
    if not args.keep_open:
        sh(["hc", "kill", target])
        # An intentional wrap-up is terminal, unlike a crash/restart which remains
        # recoverable. Mark only this known runtime record as finished.
        try:
            store = runtime_store()
            def mark(data):
                record = next((x for x in data["sessions"] if x.get("address") == target), None)
                if record: record["finished"] = True
            store.mutate(mark)
        except (DeskRuntimeError, OSError):
            pass
        for _ in range(20):  # so a wrap-up of the next agent sees this one gone
            if terminal(target).get("state") != "live":
                break
            time.sleep(0.15)


def handoff_path(cwd, slug, role_id):
    repo = repo_of(cwd) if cwd else None
    d = os.path.join(repo["common"], "team", "desks", slug) if repo else os.path.join(CHAT, f"{slug}.handoffs")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, f"handoff-{role_id}-{time.strftime('%m%d-%H%M%S')}.md")


def fresh(args):
    """A fresh session for an agent whose context got long. First the agent writes a handoff
    (what it's doing, done, next, open); when that turn ends, its hook runs --take-over: the
    same role starts in the same folder, tab and desk with the handoff as its first message,
    takes over the old one's place in the chat, and the old terminal is ended."""
    need_core()
    info = terminal(args.address)
    if info.get("state") != "live":
        die(f"{args.address} isn't a live terminal")
    addr, labels = info.get("address") or args.address, info.get("labels") or {}
    role_id, slug = labels.get("role"), labels.get("task")
    if not role_id or not slug:
        die("fresh is for desk agents (role and task labels)")
    cwd = (info.get("foreground") or {}).get("cwd") or info.get("cwd")
    if args.take_over:
        return take_over(info, addr, labels, role_id, slug, cwd)
    status = (info.get("status") or {}).get("state")
    if status == "working" and not args.force:
        die("it's working; start fresh once its turn ends (or pass --force)")
    path = handoff_path(cwd, slug, role_id)
    ctx = labels.get("ctx")
    why = send_text(addr, f"[desk] Your context is long{f' ({int(ctx) // 1000}k tokens)' if ctx else ''}, so a fresh session of you "
                          f"takes over when this turn ends. Write a handoff to {path}: what you're working on and why, what's done "
                          "(commits, files), what's next, open questions and who's waiting on what. Under 60 lines, facts only. "
                          "If you keep the decisions file, bring it up to date too. Then end your turn; start nothing new.")
    if why:
        die(f"couldn't reach it: {why}")
    sh(["hc", "label", addr, f"handoff={path}"])
    expect_reply(addr, "fresh")
    print(json.dumps({"ok": True, "handoff": path}))


def take_over(info, addr, labels, role_id, slug, cwd):
    role = next((r for r in load_roles() if r["id"] == role_id), {"name": role_id})
    path, ctx = labels.get("handoff"), labels.get("ctx")
    wrote = bool(path) and os.path.exists(path)
    task = (f"You're this desk's {role['name']}, taking over from your previous session, whose context got long. "
            + (f"Read its handoff in {path} first, then carry on" if wrote else
               f"It wrote no handoff, so read the decisions file and `{SELF} inbox --all`, then carry on")
            + " from where it left off. Don't redo finished work. If nothing is in flight, just say you're ready, in one line.")
    parent = info.get("parent")
    cmd = [SELF, "start", role_id, "--repo", cwd or os.path.expanduser("~"), "--share", "--slug", slug, "--requested",
           "--by", "fresh", "--task", task, "--fresh-of", addr,
           "--note", f"{role['name']} started fresh" + (f" (was {int(ctx) // 1000}k tokens)" if ctx else "")
           + (f". Handoff: `{path}`" if wrote else ". No handoff was written.")]
    cmd += ["--parent", parent] if parent and terminal(parent).get("state") == "live" else ["--no-parent"]
    for flag, key in (("--space", "herdr.space"), ("--tab", "herdr.tab")):
        if labels.get(key):
            cmd += [flag, labels[key]]
    r = sh(cmd)
    try:
        new = json.loads(r.stdout).get("address") if r.returncode == 0 else None
    except ValueError:
        new = None
    if not new:
        why = (r.stderr or r.stdout).strip()[:200]
        chat_append(slug, {"from": role_id, "address": addr, "kind": "flag",
                           "text": f"Couldn't start a fresh {role['name']} ({why}). The old session is still running."})
        sh(["hc", "label", addr, "handoff="])
        return
    # The new session reads the chat from where the old one stopped.
    try:
        with open(cursors_file(slug)) as f:
            cur = json.load(f)
    except (OSError, ValueError):
        cur = {}
    if addr in cur:
        cur[new] = cur.pop(addr)
        tmp = cursors_file(slug) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cur, f)
        os.replace(tmp, cursors_file(slug))
    sh(["hc", "kill", addr])
    print(json.dumps({"ok": True, "address": new, "replaced": addr, "handoff": path if wrote else None}))


def main():
    import argparse
    p = argparse.ArgumentParser(prog="team", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("role")
    s.add_argument("--repo"); s.add_argument("--brief"); s.add_argument("--task"); s.add_argument("--slug")
    s.add_argument("--parent"); s.add_argument("--no-parent", action="store_true")
    s.add_argument("--space"); s.add_argument("--requested", action="store_true"); s.add_argument("--by")
    s.add_argument("--share", action="store_true", help="work in --repo as is, never a new worktree")
    s.add_argument("--tab"); s.add_argument("--fresh-of"); s.add_argument("--note")
    r = sub.add_parser("report")
    r.add_argument("kind", choices=["done", "blocked", "update"])
    r.add_argument("--criteria", help='JSON: {"A1":"pass: note","A2":"fail: why","A3":"n/a"}')
    r.add_argument("--evidence", choices=["verified", "reported", "asserted"], default="asserted",
                   help="verified: you ran the checks and saw them pass; reported: a tool or person said so; asserted: neither")
    r.add_argument("--blocking", type=int, help="(Reviewer) how many findings block the merge")
    r.add_argument("--head", help="the commit this report is about (default: your worktree's HEAD)")
    r.add_argument("text", nargs="+")
    y = sub.add_parser("say")
    y.add_argument("text", nargs="+")
    ak = sub.add_parser("ask")
    ak.add_argument("role"); ak.add_argument("text", nargs="+")
    ro = sub.add_parser("route")
    ro.add_argument("role"); ro.add_argument("text", nargs="+")
    hk = sub.add_parser("hook")
    hk.add_argument("cli", choices=["claude", "claude-compact", "claude-permission", "claude-tool", "claude-prompt", "codex", "session"]); hk.add_argument("payload", nargs="*")
    pm = sub.add_parser("permit")
    pm.add_argument("--task", required=True); pm.add_argument("id"); pm.add_argument("decision", choices=["allow", "always", "deny"])
    pm.add_argument("--message", help="with deny: tell it what to do instead")
    ap = sub.add_parser("approve")
    ap.add_argument("--address", required=True); ap.add_argument("--choice", choices=["allow", "always", "deny"])
    ap.add_argument("--expect", help="the command or file the Desk showed; refuse if the prompt asks about anything else")
    ap.add_argument("--peek", action="store_true", help="print the prompt on screen, answer nothing")
    pw = sub.add_parser("permit-watch")
    pw.add_argument("--task", required=True); pw.add_argument("--id", required=True); pw.add_argument("--pid", type=int, required=True)
    pw.add_argument("--address", required=True)
    co = sub.add_parser("compact")
    co.add_argument("--address", required=True)
    an = sub.add_parser("answer")
    an.add_argument("id"); an.add_argument("text", nargs="+")
    ib = sub.add_parser("inbox")
    ib.add_argument("--task"); ib.add_argument("--all", action="store_true")
    q = sub.add_parser("post")
    q.add_argument("--task", required=True)
    q.add_argument("--to", action="append", default=[])
    q.add_argument("--raw", action="store_true", help="type the text exactly as given (a slash command); logged as a command")
    q.add_argument("--mode", choices=["action", "info", "interactive"], help="with --raw: what to do after typing it (default action)")
    q.add_argument("text", nargs="+")
    fi = sub.add_parser("finish")
    fi.add_argument("--address"); fi.add_argument("--keep-open", action="store_true")
    fi.add_argument("--keep-worktree", action="store_true", help="close the agent once nothing is uncommitted; keep its branch")
    fi.add_argument("--force", action="store_true", help="wrap up even while it's working")
    jn = sub.add_parser("join")
    jn.add_argument("--task", required=True); jn.add_argument("--address", required=True); jn.add_argument("--role", required=True)
    nd = sub.add_parser("new-desk")
    nd.add_argument("--name"); nd.add_argument("--repo")
    me_ = sub.add_parser("measure")
    me_.add_argument("--address", required=True); me_.add_argument("--transcript", required=True); me_.add_argument("--compacted", action="store_true")
    fr = sub.add_parser("fresh")
    fr.add_argument("--address", required=True); fr.add_argument("--force", action="store_true")
    fr.add_argument("--take-over", action="store_true", help=argparse.SUPPRESS)
    st = sub.add_parser("state")
    st.add_argument("--task")
    sub.add_parser("adopt")
    rc = sub.add_parser("recover")
    rc.add_argument("--session", required=True)
    qu = sub.add_parser("queue")
    qu.add_argument("--task", required=True); qu.add_argument("--to", action="append", default=[]); qu.add_argument("text", nargs="+")
    qe = sub.add_parser("queue-edit")
    qe.add_argument("--id", required=True); qe.add_argument("--text", required=True)
    qm = sub.add_parser("queue-move")
    qm.add_argument("--id", required=True); qm.add_argument("--direction", choices=["up", "down"], required=True)
    qc = sub.add_parser("queue-cancel")
    qc.add_argument("--id", required=True)
    sub.add_parser("queue-dispatch")
    sub.add_parser("queue-watch", help=argparse.SUPPRESS)
    ad = sub.add_parser("attention-dismiss")
    ad.add_argument("--id", required=True)
    sd = sub.add_parser("side")
    sd.add_argument("--session", required=True); sd.add_argument("--kind", choices=["side", "fork"], required=True); sd.add_argument("--text")
    for name in ("settle", "unsettle"):
        sub.add_parser(name).add_argument("--address", required=True)
    sn = sub.add_parser("snooze")
    sn.add_argument("--address", required=True); sn.add_argument("--until-ms", type=int, required=True)
    tl = sub.add_parser("timeline")
    tl.add_argument("--address", required=True); tl.add_argument("--since-ms", type=int)
    tr = sub.add_parser("transcript")
    tr.add_argument("--address", required=True); tr.add_argument("--limit", type=int)
    rs = sub.add_parser("review-send")
    rs.add_argument("--address", required=True); rs.add_argument("--file", required=True)
    ga = sub.add_parser("gate")
    ga.add_argument("--address", required=True)
    ga.add_argument("--light", metavar="WHAT_YOU_CHECKED", help="a light_review role only: pass on the CTO's own diff read, no Reviewer")
    co = sub.add_parser("cost")
    co.add_argument("--task"); co.add_argument("--json", action="store_true")
    sub.add_parser("roles")
    args = p.parse_args()
    if args.cmd == "start":
        start(args)
    elif args.cmd == "report":
        report(args)
    elif args.cmd == "say":
        say(args)
    elif args.cmd == "ask":
        ask(args)
    elif args.cmd == "answer":
        answer(args)
    elif args.cmd == "route":
        route(args)
    elif args.cmd == "hook":
        hook(args)
    elif args.cmd == "permit":
        permit(args)
    elif args.cmd == "approve":
        if not args.peek and not args.choice:
            die("approve needs --choice allow|always|deny (or --peek)")
        approve(args)
    elif args.cmd == "permit-watch":
        permit_watch(args)
    elif args.cmd == "inbox":
        inbox(args)
    elif args.cmd == "post":
        post(args)
    elif args.cmd == "finish":
        finish(args)
    elif args.cmd == "compact":
        compact(args)
    elif args.cmd == "measure":
        measure(args)
    elif args.cmd == "fresh":
        fresh(args)
    elif args.cmd == "new-desk":
        new_desk(args)
    elif args.cmd == "join":
        join(args)
    elif args.cmd == "state":
        runtime_state(args)
    elif args.cmd == "adopt":
        runtime_adopt(args)
    elif args.cmd == "recover":
        runtime_recover(args)
    elif args.cmd == "queue":
        runtime_queue(args)
    elif args.cmd == "queue-edit":
        runtime_queue_edit(args)
    elif args.cmd == "queue-move":
        runtime_queue_move(args)
    elif args.cmd == "queue-cancel":
        runtime_queue_cancel(args)
    elif args.cmd == "queue-dispatch":
        runtime_queue_dispatch(args)
    elif args.cmd == "queue-watch":
        runtime_queue_watch(args)
    elif args.cmd == "attention-dismiss":
        runtime_attention_dismiss(args)
    elif args.cmd == "side":
        runtime_side(args)
    elif args.cmd in ("settle", "unsettle", "snooze"):
        runtime_triage(args)
    elif args.cmd == "timeline":
        runtime_timeline(args)
    elif args.cmd == "transcript":
        runtime_transcript(args)
    elif args.cmd == "review-send":
        review_send(args)
    elif args.cmd == "gate":
        runtime_gate(args)
    elif args.cmd == "cost":
        cost(args)
    else:
        print(json.dumps([{k: r.get(k) for k in ("id", "name", "cli", "model", "worktree", "on_request")} for r in load_roles()]))


if __name__ == "__main__":
    try:
        main()
    except DeskRuntimeError as exc:
        die(str(exc))
