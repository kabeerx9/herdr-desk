# Herdr writes most of this folder (its AGENTS.md, type files, shipped mods,
# state, telemetry). Ignore everything, then track only what's ours.
/*
!/.gitignore
!/README.md
!/keys.json
!/settings.json

# The team launcher the Desk and its agents share.
!/bin/
/bin/*
!/bin/team

!/layouts/
/layouts/*
!/layouts/desk.json
!/layouts/desk-chat.json

# Our light theme (Herdr ships the other files in themes/).
!/themes/
/themes/*
!/themes/desk-light.json

!/mods/
/mods/*
!/mods/desk/
!/mods/desk-pane/
!/mods/desk-spaces/

# Herdr rewrites these into every mod folder on start.
jsconfig.json
gpui-kit.d.ts
__pycache__/
