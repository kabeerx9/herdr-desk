# Herdr writes most of this folder (its AGENTS.md, type files, shipped mods,
# state, telemetry). Ignore everything, then track only what's ours.
/*
!/.gitignore
!/README.md
!/keys.json
!/settings.json

# The team launcher the Desk and its agents share.
!/bin/
/bin/*
!/bin/team
!/bin/desk_runtime.py
!/bin/test_desk_runtime.py
!/bin/test_team_workflows.py
!/bin/desk_review.py
!/bin/test_desk_review.py
!/bin/test_desk_timeline.py
!/bin/test_team_overhaul.py
!/bin/test_desk_transcript.py
!/bin/test_desk_commands.py
!/bin/test_desk_approve.py
!/bin/test_desk_cost.py
!/bin/test_desk_codex.py
!/bin/test_desk_adapters.py
!/bin/test_desk_cursors.py
# Adapters for the CLIs the Desk runs (docs/plans/2026-11-07-adapter-layer.md).
!/bin/desk_adapters/
/bin/desk_adapters/__pycache__/
# Real agent screens the command tests classify.
!/bin/fixtures/

!/layouts/
/layouts/*
!/layouts/desk.json
!/layouts/desk-chat.json

# Our light theme (Herdr ships the other files in themes/).
!/themes/
/themes/*
!/themes/desk-light.json
!/themes/desk-dark.json

!/mods/
/mods/*
!/mods/desk/
!/mods/desk-pane/
!/mods/desk-spaces/
!/mods/desk-chrome/
!/mods/desk-status/

# Herdr rewrites these into every mod folder on start.
jsconfig.json
gpui-kit.d.ts
__pycache__/

# Our workflow design and verification notes.
!/docs/
/docs/*
!/docs/plans/
